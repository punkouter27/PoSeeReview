{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kill-api-processes",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-Process PoSeeReview.Api -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Get-CimInstance Win32_Process -Filter \"Name='dotnet.exe'\" -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -match 'PoSeeReview[.]Api' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Write-Host 'Stopped PoSeeReview.Api and its dotnet host.'"
      ],
      "problemMatcher": []
    },
    {
      "label": "start-api-https",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/PoSeeReview.Api",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "csharp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Now listening on:\\s+https://localhost:5001"
        }
      }
    },
    {
      "label": "start-azurite",
      "type": "shell",
      "command": "pwsh -NoProfile -File SCRIPTS/start-azurite.ps1",
      "problemMatcher": []
    },
    {
      "label": "start-api-watch",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "src/PoSeeReview.Api",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "csharp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Now listening on:\\s+https://localhost:5001"
        }
      }
    },
    {
      "label": "start-api-clean",
      "dependsOrder": "sequence",
      "dependsOn": [
        "kill-api-processes",
        "start-azurite",
        "start-api-https"
      ],
      "problemMatcher": []
    },
    {
      "label": "start-api-watch-clean",
      "dependsOrder": "sequence",
      "dependsOn": [
        "kill-api-processes",
        "start-azurite",
        "start-api-watch"
      ],
      "problemMatcher": []
    }
  ]
}
