@* One row for every list of comics — the live board, the weekly archive and /my-comics.

   Those were three hand-built layouts of the same four facts (thumbnail, name, score, open), and
   the live board was a data grid: paging over ten rows, sorting a ranking by name, and five
   fixed-width columns that crushed a phone. The whole row is the link (the name stretches over
   it), so there is no per-row "Open" button; `Actions` holds only what is left once opening is
   free — share, forget. Styles live in app.css (`.comic-row`) next to the freshness and
   rank-movement rules that key off the same elements. *@

@if (Skeleton)
{
    <li class="comic-row glass" aria-hidden="true">
        @Leading
        <div class="comic-thumbnail sk-block"></div>
        <div class="comic-row-body">
            <span class="sk-block sk-line"></span>
            <span class="sk-block sk-line sk-line--meta"></span>
        </div>
    </li>
}
else
{
<li class="comic-row glass scroll-enter @Class" @attributes="Attributes">
    @Leading
    <div class="comic-thumbnail">
        @if (ImageUrl is null)
        {
            @* The blob is gone but the record is not. A score beats a broken image. *@
            <span class="comic-thumbnail-gone">@Score</span>
        }
        else
        {
            <img src="@ImageUrl" alt="" loading="lazy" />
        }
    </div>
    <div class="comic-row-body">
        <a class="comic-row-name" href="@Href">@Name</a>
        <span class="comic-row-meta"><strong>@Score weird</strong>@(Meta is null ? "" : $" · {Meta}")</span>
    </div>
    @Actions
</li>
}

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = default!;
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public int Score { get; set; }

    /// <summary>A placeholder with a loaded row's geometry; only <see cref="Leading"/> is read.</summary>
    [Parameter] public bool Skeleton { get; set; }

    /// <summary>Null when the artwork has expired; the score takes the thumbnail's place.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public string? Meta { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Leading { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
