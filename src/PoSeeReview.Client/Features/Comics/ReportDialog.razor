@* The user-facing report flow.

   The app publishes AI-generated content about real, named businesses and had no way for a
   person to flag any of it: /api/takedowns is gated behind a shared admin key and deletes the
   comic outright. This posts to /api/reports, which records a signal and deletes nothing.

   Contact email is optional on purpose. Requiring an address on "this comic is offensive"
   suppresses exactly the reports worth having.

   A Radzen dialog (DialogService): modal, focus-trapped, Escape and the overlay both close it,
   and focus returns to the page. The panel below is its content.

   Sending closes the dialog at once and offers Undo on the toast for a few seconds; the report
   only leaves when that window passes. There is no "Thanks" screen to dismiss — one tap fewer,
   and a mis-tap is recoverable without a confirm step. A failure still says so, on the toast. *@
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Shared.Enums
@using PoSeeReview.Shared.Validation
@implements IDisposable
@inject ApiClient ApiClient
@inject DialogService Dialogs
@inject FxService Fx
@inject ToastService Toasts

@code {
    /// <summary>The dialog's content. Defined here, so the scoped .report-* styles still reach it.</summary>
    private RenderFragment Panel => __builder =>
    {
        <div class="report-panel">
            <p class="report-body">
                Comics are generated by AI from public reviews of <strong>@RestaurantName</strong>.
                Tell us what's wrong and we'll review it.
            </p>

            @* A real form: Enter submits. Validated with the same FluentValidation rules the API runs
               (ComicReportRequestValidator, Shared), shown inline under each field; novalidate keeps
               the browser's own bubbles out of it. *@
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" novalidate>
                <FluentValidationValidator TModel="ComicReportRequestDto" Validator="Validator" />
                <fieldset class="report-reasons">
                    <legend class="visually-hidden">Reason for reporting</legend>
                    <RadzenRadioButtonList TValue="ComicReportReason" @bind-Value="_model.Reason" Name="report-reason"
                                           Orientation="Orientation.Vertical" class="report-reason-list">
                        <Items>
                            @foreach (var (reason, label) in Reasons)
                            {
                                <RadzenRadioButtonListItem TValue="ComicReportReason" Value="reason" Text="@label" />
                            }
                        </Items>
                    </RadzenRadioButtonList>
                    <ValidationMessage For="() => _model.Reason" />
                    <ValidationMessage For="() => _model.PlaceId" />
                </fieldset>

                <label class="report-field">
                    <span class="report-label">Anything else? (optional)</span>
                    <RadzenTextArea class="sr-plain report-textarea" Rows="3"
                                    MaxLength="@ComicReportRequestValidator.MaxDetailsLength"
                                    @bind-Value="_model.Details"
                                    Placeholder="What should we look at?" />
                    <ValidationMessage For="() => _model.Details" />
                </label>

                <label class="report-field">
                    <span class="report-label">Your email (optional — only if you want a reply)</span>
                    <RadzenTextBox class="sr-plain report-input" type="email" autocomplete="email" @bind-Value="_model.ContactEmail" Placeholder="you@example.com" />
                    <ValidationMessage For="() => _model.ContactEmail" />
                </label>

                <div class="report-actions">
                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="sr-plain btn btn-primary">Send report</RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="sr-plain btn btn-secondary" Click="CloseAsync">Cancel</RadzenButton>
                </div>
            </EditForm>
        </div>
    };

    [Parameter, EditorRequired]
    public string PlaceId { get; set; } = string.Empty;

    [Parameter]
    public string RestaurantName { get; set; } = "this restaurant";

    /// <summary>Raised when the dialog should close, whether or not anything was submitted.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>The API's own rules; stateless, so one instance serves every dialog.</summary>
    private static readonly ComicReportRequestValidator Validator = new();

    /// <summary>How long Undo is offered before the report actually leaves.</summary>
    private static readonly TimeSpan UndoWindow = TimeSpan.FromSeconds(5);

    private static readonly (ComicReportReason Reason, string Label)[] Reasons =
    [
        (ComicReportReason.Inaccurate, "It says things that aren't in the reviews"),
        (ComicReportReason.Offensive, "The image or text is offensive"),
        (ComicReportReason.TargetsAPerson, "It identifies or targets a real person"),
        (ComicReportReason.OwnerRequest, "I represent this business and want it removed"),
        (ComicReportReason.Other, "Something else")
    ];

    private readonly ComicReportRequestDto _model = new() { Reason = ComicReportReason.Inaccurate };
    private bool _submitting;
    private bool _open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Resolves when the dialog closes by any route (Send, Cancel, Escape, the overlay or the X),
        // so the parent hears about every close exactly once.
        _open = true;
        await Dialogs.OpenAsync("Report this comic", _ => Panel, new DialogOptions
        {
            CssClass = "report-dialog",
            Width = "min(32rem, calc(100vw - 2rem))",
            CloseDialogOnEsc = true,
            CloseDialogOnOverlayClick = true
        });
        _open = false;
        await OnClose.InvokeAsync();
    }

    protected override void OnParametersSet() => _model.PlaceId = PlaceId;

    private async Task SubmitAsync()
    {
        // A double Enter or double tap lands here twice before the dialog has closed.
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        var request = new ComicReportRequestDto
        {
            PlaceId = _model.PlaceId,
            Reason = _model.Reason,
            Details = _model.Details.Trim(),
            ContactEmail = _model.ContactEmail.Trim()
        };

        await CloseAsync();
        // Outlives this component (the parent unmounts it on close); only services are touched.
        _ = SendUnlessUndoneAsync(ApiClient, Toasts, Fx, request);
    }

    private static async Task SendUnlessUndoneAsync(ApiClient api, ToastService toasts, FxService fx, ComicReportRequestDto request)
    {
        if (await toasts.ShowUndoableAsync("Report sent", UndoWindow))
        {
            return;
        }

        try
        {
            var response = await api.SubmitReportAsync(request);
            if (!string.IsNullOrWhiteSpace(response.Message))
            {
                toasts.Show(response.Message);
            }
            await fx.PlayConfirmAsync();
        }
        catch (HttpRequestException ex)
        {
            // Surfaced rather than swallowed. Someone reporting content needs to know whether
            // it was actually received — a silent failure here is worse than no button.
            toasts.Show(string.IsNullOrWhiteSpace(ex.Message)
                ? "We couldn't send that report. Please try again."
                : ex.Message);
            await fx.PlayErrorAsync();
        }
    }

    private Task CloseAsync()
    {
        if (_open)
        {
            Dialogs.Close();
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        if (_open)
        {
            _open = false;
            Dialogs.Close();
        }
    }
}
