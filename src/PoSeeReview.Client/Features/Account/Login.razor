@page "/login"
@layout BareLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Login · PoSeeReview</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-logo">
            <svg class="login-brand-icon" width="48" height="48" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.95"/>
                <rect x="15" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.75"/>
                <rect x="1" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.75"/>
                <rect x="15" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.5"/>
            </svg>
            <span class="login-brand-name">PoSeeReview</span>
        </div>
        <h1>Welcome Back</h1>
        <p>Sign in to discover strange restaurant stories nearby and turn them into shareable comics.</p>

        <div class="login-actions">
            <button type="button" class="btn btn-primary login-btn-microsoft" @onclick="LoginWithMicrosoft">
                <svg class="login-btn-icon" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                    <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                    <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                </svg>
                Sign in with Microsoft
            </button>
            @* Guest bypass renders in Dev AND Test (NET_RULES 4.4). Test used to auto-navigate
               instead of rendering the button, which contradicted the E2E UI suite — every one
               of its tests clicks "Continue as guest" and so only ever worked against Dev. *@
            @if (IsDevelopment || IsTest)
            {
                <button type="button" class="btn btn-secondary" @onclick="LoginAsGuest">Continue as guest</button>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool IsDevelopment => HostEnvironment.Environment == "Development";
    private bool IsTest => HostEnvironment.Environment == "Test";

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/";

    private string EscapedReturnUrl => Uri.EscapeDataString(SafeReturnUrl);

    protected override async Task OnInitializedAsync()
    {
        // Already signed in? Don't show the login screen — send them where they were headed.
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(SafeReturnUrl, replace: true);
            }
        }
    }

    private void LoginWithMicrosoft() =>
        Navigation.NavigateTo($"auth/login/microsoft?returnUrl={EscapedReturnUrl}", forceLoad: true);

    private void LoginAsGuest() =>
        Navigation.NavigateTo($"auth/login/fake?returnUrl={EscapedReturnUrl}", forceLoad: true);
}
