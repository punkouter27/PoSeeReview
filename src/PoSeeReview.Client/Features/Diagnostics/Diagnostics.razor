@page "/diag"
@page "/diagnostics"
@attribute [AllowAnonymous]
@using System.Diagnostics
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using Radzen
@using Radzen.Blazor
@inject ApiClient ApiClient
@inject ILogger<Diagnostics> Logger

@* The fleet /diag page (standard of 2026-11-17): anonymous, plain English, every environment.
   Everything shown comes from GET /api/diag, which only ever returns statuses, timings and fixed
   descriptions — the API's DiagnosticsSnapshotQueryHandler is the safety boundary, not this page.
   /diagnostics is kept as an alias for old bookmarks. *@

<PageTitle>System status · PoSeeReview</PageTitle>

<RadzenScope>
<PageShell Title="System status" Width="PageShell.ShellWidth.Wide" Class="diagnostics-container">
    <Header>
            <RadzenButton Text="@(_refreshing ? "Refreshing…" : "Refresh")"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Secondary"
                          Disabled="@_refreshing"
                          Click="@LoadAsync"
                          class="diag-refresh" />
    </Header>
    <ChildContent>
        <div class="po-diag diag-body">
            @if (_snapshot is null && _refreshing)
            {
                <div class="diag-loading" role="status">
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    <p>Checking every part of the app…</p>
                </div>
            }
            else if (_snapshot is null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Title="We couldn't reach the app's server" class="diag-banner" data-status="error">
                    The server didn't answer the status check, so we can't tell how its parts are doing.
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <span> (@_error)</span>
                    }
                    Try Refresh in a moment.
                </RadzenAlert>
                <section class="po-diag__group diag-section" data-section="api">
                    <h2 class="diag-section-title">API</h2>
                    <div class="po-diag__card diag-row">
                        <span class="diag-row-name">App server</span>
                        <span class="po-badge po-badge--bad">Not reachable</span>
                    </div>
                </section>
            }
            else
            {
                var snapshot = _snapshot;
                <RadzenAlert AlertStyle="@BannerStyle(snapshot.Status)" AllowClose="false" Title="@BannerTitle(snapshot.Status)" class="diag-banner" data-status="@snapshot.Status.ToLowerInvariant()">
                    @BannerBody(snapshot.Status)
                    @if (snapshot.IsMockData)
                    {
                        <span> This copy runs on sample places and mocked AI, so nothing it shows is real.</span>
                    }
                </RadzenAlert>

                <section class="po-diag__group diag-section" data-section="api">
                    <h2 class="diag-section-title">API</h2>
                    <div class="po-diag__card diag-row">
                        <div class="diag-row-main">
                            <span class="diag-row-name">App server</span>
                            <span class="diag-row-purpose">Answers every request the app makes.</span>
                        </div>
                        <span class="po-badge po-badge--ok">Reachable</span>
                        <span class="diag-row-meta">Responded in @FormatMs(_apiMilliseconds)</span>
                    </div>
                </section>

                @CheckSection("Data", "storage", snapshot.Checks.Where(c => c.Kind == DiagnosticsCheckKinds.Storage).ToList())
                @CheckSection("Services", "services", snapshot.Checks.Where(c => c.Kind != DiagnosticsCheckKinds.Storage).ToList())

                <section class="po-diag__group diag-section diag-about" data-section="about">
                    <h2 class="diag-section-title">About this copy</h2>
                    <dl class="diag-facts">
                        <div><dt>Version</dt><dd data-fact="version">v@(snapshot.BuildStamp)</dd></div>
                        <div><dt>Environment</dt><dd data-fact="environment">@snapshot.Environment</dd></div>
                        <div><dt>Checked</dt><dd>@snapshot.Timestamp.ToLocalTime().ToString("HH:mm:ss") (took @FormatMs(snapshot.DurationMilliseconds))</dd></div>
                    </dl>
                </section>

                <details class="diag-section diag-graphics">
                    <summary>Graphics on this device</summary>
                    <FrameBudget />
                </details>
            }
        </div>
    </ChildContent>
</PageShell>
</RadzenScope>

@code {
    private DiagnosticsSnapshotDto? _snapshot;
    private double _apiMilliseconds;
    private bool _refreshing = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _refreshing = true;
        _error = null;
        StateHasChanged();

        try
        {
            var stopwatch = Stopwatch.StartNew();
            var snapshot = await ApiClient.GetDiagnosticsSnapshotAsync();
            _apiMilliseconds = stopwatch.Elapsed.TotalMilliseconds;
            _snapshot = snapshot;
            if (snapshot is null)
            {
                _error = "empty response";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // Logged, not shown: the banner says what matters in plain words.
            Logger.LogWarning(ex, "Diagnostics snapshot failed");
            _snapshot = null;
            _error = ex is TaskCanceledException ? "timed out" : null;
        }
        finally
        {
            _refreshing = false;
        }
    }

    private RenderFragment CheckSection(string title, string key, List<DiagnosticsCheckDto> checks) => @<section class="po-diag__group diag-section" data-section="@key">
        <h2 class="diag-section-title">@title</h2>
        @if (checks.Count == 0)
        {
            <p class="diag-empty">Nothing to check here.</p>
        }
        else
        {
            @foreach (var check in checks)
            {
                <div class="po-diag__card diag-row" data-check="@check.Name">
                    <div class="diag-row-main">
                        <span class="diag-row-name">@check.Name</span>
                        <span class="diag-row-purpose">@check.Purpose</span>
                    </div>
                    <span class="po-badge po-badge--@BadgeFor(check.Status)">@check.Status</span>
                    <span class="diag-row-meta">
                        @check.Detail
                        @if (check.DurationMilliseconds is { } ms)
                        {
                            <span> · @FormatMs(ms)</span>
                        }
                        @if (!string.IsNullOrEmpty(check.ErrorType))
                        {
                            <span> · @check.ErrorType</span>
                        }
                        <span class="diag-row-time"> · checked @check.CheckedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                    </span>
                </div>
            }
        }
    </section>;

    private static string FormatMs(double ms) => ms < 1 ? "under 1 ms" : $"{ms:F0} ms";

    private static string BadgeFor(string status) => status switch
    {
        "Healthy" => "ok",
        "Degraded" => "warn",
        _ => "bad"
    };

    private static AlertStyle BannerStyle(string status) => status switch
    {
        "Healthy" => AlertStyle.Success,
        "Degraded" => AlertStyle.Warning,
        _ => AlertStyle.Danger
    };

    private static string BannerTitle(string status) => status switch
    {
        "Healthy" => "Everything is working",
        "Degraded" => "Working, with some problems",
        _ => "Something is broken"
    };

    private static string BannerBody(string status) => status switch
    {
        "Healthy" => "Every part of the app answered its check.",
        "Degraded" => "The app is up, but at least one part below is slow or not set up.",
        _ => "At least one part below is not working, so some features will fail."
    };
}
