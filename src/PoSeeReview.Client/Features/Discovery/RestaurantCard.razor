@using PoSeeReview.Shared.Dtos
@inject FxService Fx

@* data-cached is the hook for the card's material (see "READY vs COSTS SOMETHING" in app.css).

   The status and the button used to be two elements that could contradict each other: a
   "Ready now" pill beside a "Generate Comic" button on a comic that was already drawn. The button
   now says what the tap does — open a ready comic for free (primary), or spend ~10s and a
   generation on a new one (secondary: the product working, not a hazard, but the costlier tap). Distance and review count share one line; the address gets one. *@
<article class="@($"restaurant-card scroll-enter {GetCardClass()}")"
            title="@GetTooltipText()"
            data-testid="restaurant-card"
            data-comic-card
            data-cached="@(IsCached ? "ready" : "new")"
            data-forecast="@ForecastState"
            @onclick="OnClickIfEnabled">
    <div class="card-header">
        <h2 class="restaurant-name">@Restaurant.Name</h2>
        @if (Restaurant.AverageRating > 0)
        {
            <span class="rating-chip" title="@Restaurant.AverageRating.ToString("F1") / 5">
                <span aria-hidden="true">★ @Restaurant.AverageRating.ToString("F1")</span>
                <span class="visually-hidden">Rated @Restaurant.AverageRating.ToString("F1")</span>
            </span>
        }
    </div>
    <p class="address">@Restaurant.Address</p>
    <p class="card-meta">
        @if (Restaurant.Distance > 0)
        {
            @FormatDistance(Restaurant.Distance)<text> · </text>
        }
        @Restaurant.TotalReviews review@(Restaurant.TotalReviews == 1 ? "" : "s")
    </p>
    @if (IsTooNormal)
    {
        <p class="forecast-hint" data-testid="forecast-hint">
            Its reviews scored @Forecast — under the @ForecastFloor needed to draw.
        </p>
    }
    else if (Forecast is { } forecast)
    {
        <p class="forecast-chip" data-testid="forecast-chip" title="What these reviews scored last time someone tried. Drawing keeps that score.">
            Forecast: <strong>@forecast</strong> weird
        </p>
    }
    @if (IsTooNormal)
    {
        <div class="cta-wrap" @onclick:stopPropagation="true">
            <button type="button" class="btn btn-secondary cta-btn" disabled>Too normal to draw</button>
        </div>
    }
    else if (IsEnabled)
    {
        @* The whole card is clickable too, so the button's click must not also bubble up to it.
           stopPropagation is only valid on an HTML element, hence the wrapper. *@
        <div class="cta-wrap" @onclick:stopPropagation="true">
            <button type="button" class="btn @(IsCached ? "btn-primary" : "btn-secondary") cta-btn" disabled="@IsLoading"
                    @onclick="OnClickIfEnabled" data-testid="comic-generate-btn"
                    title="@(IsCached ? "Already drawn — opens instantly and costs nothing" : "Not drawn yet — takes about 10 seconds and uses one of today's generations")">
                @if (IsLoading)
                {
                    <text>Opening comic...</text>
                }
                else if (IsCached)
                {
                    <span class="cache-dot" aria-hidden="true"></span><text> Open comic</text>
                }
                else
                {
                    <text>Draw comic · ~10s</text>
                }
            </button>
        </div>
    }
    else
    {
        <p class="not-enough-hint">No reviews yet — nothing to draw from.</p>
    }
</article>

@code {
    [Parameter]
    public RestaurantDto Restaurant { get; set; } = null!;

    [Parameter]
    public EventCallback<RestaurantDto> OnRestaurantClick { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Whether a live comic already exists for this place.
    /// <para>
    /// Best-effort and allowed to be wrong: it comes from a batched cache probe, and a comic can
    /// expire between that answer and the tap. Nothing depends on it being right — it changes the
    /// card's material and which tap cue plays, and a stale "ready" costs the user a ten-second
    /// wait they were told would be instant, never a wrong result.
    /// </para>
    /// </summary>
    [Parameter]
    public bool IsCached { get; set; }

    /// <summary>
    /// Mirrors the API's floor (ComicOptions.MinimumReviewsRequired = 1): a comic needs at
    /// least one review to draw from. The card used to demand 5, which disagreed with the
    /// server and hid perfectly generatable places.
    /// </summary>
    private bool IsEnabled => Restaurant.TotalReviews > 0;

    /// <summary>
    /// The weirdness forecast for an undrawn place: what its reviews scored the last time anyone
    /// tried, under the current prompt. Null when nobody has. Like <see cref="IsCached"/> it is a
    /// best-effort hint, but a stale one costs at most a refunded attempt.
    /// </summary>
    [Parameter]
    public int? Forecast { get; set; }

    /// <summary>The server's too-ordinary cutoff (Comics:MinimumStrangenessScore).</summary>
    [Parameter]
    public int ForecastFloor { get; set; }

    /// <summary>
    /// Already known to be refused. The server would spend nothing — the attempt is refunded —
    /// but the visitor would wait for a sad trombone; saying so on the card saves the trip.
    /// </summary>
    private bool IsTooNormal => !IsCached && Forecast is { } f && f < ForecastFloor;

    private string? ForecastState => IsCached || Forecast is null ? null : IsTooNormal ? "ordinary" : "weird";

    private string GetCardClass()
    {
        if (!IsEnabled || IsTooNormal) return "disabled";
        return GetTierClass();
    }

    private string GetTooltipText()
    {
        return IsEnabled
            ? (IsLoading ? "Opening comic" : IsCached ? "Open comic" : "Click to generate a comic based on reviews")
            : "This restaurant has no reviews yet, so there's nothing to draw from";
    }

    /// <summary>
    /// Plays the tap panned to where the card actually is, then hands off to the page.
    /// <para>
    /// The sound is emitted here rather than in the page's handler for one reason: only this
    /// component knows the pointer coordinate. Panning by <see cref="ElementReference"/> from the
    /// page would mean an <c>@@ref</c> per card in a repeated list, and panning from the page's
    /// handler would centre every card in the grid — which is the behaviour worth improving on.
    /// </para>
    /// </summary>
    private async Task OnClickIfEnabled(MouseEventArgs args)
    {
        if (IsEnabled && !IsLoading && !IsTooNormal)
        {
            // A click is a trusted gesture, so this is also a valid point to unlock audio.
            await Fx.UnlockAudioAsync();
            // Voiced by consequence, not just position. The cached cue is bright and resolves
            // immediately; the uncached one is lower and leaves a note hanging, because something
            // is now going to take ten seconds and spend money.
            await Fx.PlayTapAtAsync(args.ClientX, IsCached);
            await OnRestaurantClick.InvokeAsync(Restaurant);
        }
    }

    private string GetTierClass() => Restaurant.AverageRating switch
    {
        >= 4.0 => "tier-high",
        >= 3.0 => "tier-mid",
        _      => "tier-low"
    };

    // A location search has no user coordinates, so Distance comes back 0 for every result.
    // Rendering that as "0m away" claimed the restaurant was underfoot; callers suppress it
    // entirely instead. Same for a 0 rating, which means "unrated", not "rated 0.0".
    private string FormatDistance(double kilometers)
    {
        if (kilometers < 1.0)
        {
            var meters = kilometers * 1000;
            return $"{Math.Round(meters)}m away";
        }
        else
        {
            return $"{kilometers:F1}km away";
        }
    }
}
