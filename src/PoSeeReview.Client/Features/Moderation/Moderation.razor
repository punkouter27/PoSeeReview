@page "/moderation"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject ModerationClient ModerationApi
@inject NavigationManager Navigation
@using Radzen
@using Radzen.Blazor
@inject FxService Fx
@inject DialogService Dialogs

<PageTitle>Moderation · PoSeeReview</PageTitle>

@* No nav entry, reached by URL — the same posture as /diagnostics, and for the same reason:
   operator tooling does not belong in a consumer app's primary navigation, and
   HeaderContractUiTests asserts that nav is exactly two items. *@
<PageShell Title="Moderation"
           Width="PageShell.ShellWidth.Wide"
           Class="moderation-page">

    <AuthorizeView Roles="Moderator">
        <NotAuthorized>
            @* UI-only. The server enforces the same role on every endpoint below, so this is a
               courtesy that saves a round trip, not the control. *@
            <StateCard Icon="🔒" Title="Moderators only">
                <ChildContent>Your account does not hold the moderator role.</ChildContent>
                <Actions><a href="/" class="btn btn-primary">Back to PoSeeReview</a></Actions>
            </StateCard>
        </NotAuthorized>

        <Authorized>
            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert">
                    <p>@_error</p>
                    <button type="button" class="btn btn-primary" @onclick="LoadAsync">Try again</button>
                </div>
            }

            @if (_queue is null)
            {
                @* Skeleton rows in the queue's shape rather than a spinner, so the list lands in place. *@
                <p class="visually-hidden" role="status">Loading the moderation queue...</p>
                <ul class="comic-rows">
                    @for (var i = 0; i < 4; i++)
                    {
                        <ComicRow Skeleton="true" Href="" Name="" />
                    }
                </ul>
            }
            else if (_queue.Items.Count == 0)
            {
                <StateCard Icon="✅" Title="Queue is empty">
                    Nothing has been reported or actioned in the last few weeks.
                </StateCard>
            }
            else
            {
                <p class="moderation-summary">
                    @_queue.Items.Count item@(_queue.Items.Count == 1 ? "" : "s") ·
                    comics auto-hide at @_queue.AutoHideThreshold independent reports
                </p>

                @* A sortable grid on a desktop, where an operator scans and compares many rows; under
                   48rem the same queue as cards (newest first), because the grid's seven columns
                   scrolled sideways on a phone. Both are rendered and CSS picks one; the action menu
                   is one template (ActionsFor) keyed per layout so popover ids stay unique. Remove
                   still names what it erases, in a confirm dialog. *@
                <RadzenScope>
                <ul class="moderation-cards">
                    @foreach (var item in _queue.Items.OrderByDescending(i => i.LastReportedAt))
                    {
                        <li class="moderation-card" data-reviewed="@(item.IsReviewed ? "true" : null)">
                            <div class="moderation-card-head">
                                <span class="moderation-name">@(string.IsNullOrWhiteSpace(item.RestaurantName) ? "(comic no longer cached)" : item.RestaurantName)</span>
                                <span class="moderation-card-badges">
                                    <RadzenBadge BadgeStyle="@StateStyle(item)" Text="@StateText(item)" />
                                    @if (!item.IsReviewed)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="New" />
                                    }
                                </span>
                            </div>
                            <span class="moderation-place">@item.PlaceId</span>
                            <dl class="moderation-card-facts">
                                <div><dt>Reports</dt><dd>@item.ReportCount</dd></div>
                                <div><dt>Top reason</dt><dd>@item.TopReason</dd></div>
                                <div><dt>Last activity</dt><dd>@RelativeTime.Format(item.LastReportedAt)</dd></div>
                                <div><dt>Comic</dt><dd>@(item.HasLiveComic ? "cached" : "expired")</dd></div>
                            </dl>
                            @ActionsFor(item, "card")
                        </li>
                    }
                </ul>
                <div class="moderation-grid">
                    <RadzenDataGrid TItem="ModerationItemDto" Data="@_queue.Items" class="moderation-list"
                                    AllowSorting="true" AllowPaging="true" PageSize="20" Density="Density.Compact"
                                    RowRender="@MarkReviewed" EmptyText="Nothing to review.">
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(ModerationItemDto.RestaurantName)" Title="Restaurant" MinWidth="14rem">
                                <Template Context="item">
                                    <span class="moderation-name">@(string.IsNullOrWhiteSpace(item.RestaurantName) ? "(comic no longer cached)" : item.RestaurantName)</span>
                                    <span class="moderation-place">@item.PlaceId</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="State" Sortable="false" Width="9rem">
                                <Template Context="item">
                                    <RadzenBadge BadgeStyle="@StateStyle(item)" Text="@StateText(item)" />
                                    @if (!item.IsReviewed)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="New" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(ModerationItemDto.ReportCount)" Title="Reports" Width="6rem" TextAlign="TextAlign.End" />
                            <RadzenDataGridColumn Property="@nameof(ModerationItemDto.TopReason)" Title="Top reason" Width="9rem" />
                            <RadzenDataGridColumn Property="@nameof(ModerationItemDto.LastReportedAt)" Title="Last activity" Width="9rem"
                                                  SortOrder="SortOrder.Descending">
                                <Template Context="item">@RelativeTime.Format(item.LastReportedAt)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(ModerationItemDto.HasLiveComic)" Title="Comic" Width="6rem">
                                <Template Context="item">@(item.HasLiveComic ? "cached" : "expired")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Actions" Sortable="false" MinWidth="9rem">
                                <Template Context="item">
                                    @ActionsFor(item, "grid")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
                </RadzenScope>
            }
        </Authorized>
    </AuthorizeView>

    @* The triage readout lives in a side drawer, not inside the row: it used to blow the row open
       and re-introduce the exact layout shift the Remove confirm was moved into a dialog to fix. *@
    @if (_drawerItem is { } drawer)
    {
        <div class="moderation-drawer-scrim" @onclick="() => _drawerItem = null"></div>
        <aside class="moderation-drawer" role="dialog" aria-modal="true" aria-labelledby="moderation-drawer-title">
            <div class="moderation-drawer-head">
                <h2 id="moderation-drawer-title" class="moderation-drawer-title">
                    AI triage · @(string.IsNullOrWhiteSpace(drawer.RestaurantName) ? drawer.PlaceId : drawer.RestaurantName)
                </h2>
                <button type="button" class="btn btn-secondary btn-icon" aria-label="Close triage" @onclick="() => _drawerItem = null">
                    <span aria-hidden="true">&#215;</span>
                </button>
            </div>
            @if (drawer.Triage is { } triage)
            {
                <div class="moderation-triage" data-suggestion="@triage.Suggestion" data-testid="moderation-triage">
                    <p class="moderation-triage-verdict">AI suggests <strong>@triage.Suggestion</strong> · @triage.Confidence% sure</p>
                    <p class="moderation-triage-summary">@triage.Summary</p>
                    @if (triage.Concerns.Length > 0)
                    {
                        <ul class="moderation-triage-concerns">
                            @foreach (var concern in triage.Concerns)
                            {
                                <li>@concern</li>
                            }
                        </ul>
                    }
                </div>
            }
            else
            {
                <p class="moderation-note">No triage advice yet.</p>
            }
        </aside>
    }
</PageShell>

@code {
    private enum ModerationAction { Hide, Restore, Suppress, Remove }

    private ModerationQueueDto? _queue;
    private string? _error;
    private bool _isBusy;
    private string? _triaging;
    private ModerationItemDto? _drawerItem;

    /// <summary>
    /// One at a time: each is a paid model call, and the answer lands on the row it was asked for
    /// rather than reloading the queue under the moderator's eyes.
    /// </summary>
    private async Task TriageAsync(ModerationItemDto item)
    {
        _triaging = item.PlaceId;
        _error = null;

        try
        {
            item.Triage = await ModerationApi.TriageAsync(item.PlaceId);
            _drawerItem = item;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                ? "AI triage is not available on this deployment."
                : "The AI triage did not come back. Nothing was changed.";
        }
        finally
        {
            _triaging = null;
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // The queue is only fetched for a moderator — anyone else sees the NotAuthorized card, so
    // the call could only ever come back 403 and land in the console as an error.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null && (await AuthState).User.IsInRole("Moderator"))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        _queue = null;
        StateHasChanged();

        try
        {
            _queue = await ModerationApi.GetQueueAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode == System.Net.HttpStatusCode.Forbidden
                ? "Your account does not hold the moderator role."
                : "The moderation queue could not be loaded.";
        }
    }

    private static string StateText(ModerationItemDto item) =>
        item.IsSuppressed ? "Suppressed" : item.IsHidden ? "Hidden" : "Live";

    private static BadgeStyle StateStyle(ModerationItemDto item) =>
        item.IsSuppressed ? BadgeStyle.Danger : item.IsHidden ? BadgeStyle.Warning : BadgeStyle.Success;

    private static void MarkReviewed(RowRenderEventArgs<ModerationItemDto> args)
    {
        if (args.Data is { IsReviewed: true })
        {
            args.Attributes.Add("data-reviewed", true);
        }
    }

    /// <summary>A row's Open button and action menu, shared by the grid and the cards. <paramref name="where"/> keeps the popover ids unique, since both layouts are in the DOM.</summary>
    private RenderFragment ActionsFor(ModerationItemDto item, string where) => @<text>
        <div class="moderation-actions">
            <RadzenButton Text="Open" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base"
                          Click="@(() => Navigation.NavigateTo($"/comic/{item.PlaceId}"))" />
            @* One overflow menu instead of five inline buttons: the row stays
               compact and every action is still one tap away. *@
            <button type="button" class="btn btn-secondary btn-icon moderation-menu-btn"
                    popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                    title="More actions" aria-label="@($"More actions for {item.RestaurantName}")">
                <span aria-hidden="true">⋯</span>
            </button>
            <div id="@($"mod-menu-{where}-{item.PlaceId}")" class="popover-menu moderation-popover" popover>
                @if (item.IsHidden)
                {
                    <button type="button" class="popover-menu-item" popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                            disabled="@_isBusy" @onclick="() => ActAsync(item, ModerationAction.Restore)">Clear</button>
                }
                else
                {
                    <button type="button" class="popover-menu-item" popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                            disabled="@_isBusy" @onclick="() => ActAsync(item, ModerationAction.Hide)">Hide</button>
                }
                @if (!item.IsSuppressed)
                {
                    <button type="button" class="popover-menu-item" popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                            disabled="@_isBusy" @onclick="() => ActAsync(item, ModerationAction.Suppress)">Suppress</button>
                }
                @if (item.HasLiveComic)
                {
                    <button type="button" class="popover-menu-item" popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                            disabled="@(_isBusy || _triaging is not null)"
                            @onclick="() => TriageAsync(item)">@(_triaging == item.PlaceId ? "Reading…" : item.Triage is null ? "AI triage" : "Re-triage")</button>
                }
                @if (item.Triage is not null)
                {
                    <button type="button" class="popover-menu-item" popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                            @onclick="() => _drawerItem = item">View triage</button>
                }
                <hr class="popover-menu-divider" />
                <button type="button" class="popover-menu-item moderation-menu-item--danger" popovertarget="@($"mod-menu-{where}-{item.PlaceId}")"
                        disabled="@_isBusy" @onclick="() => ConfirmRemoveAsync(item)">Remove</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(item.Reason))
        {
            <p class="moderation-note">@item.Reason</p>
        }
    </text>;

    /// <summary>
    /// The confirm names what it erases: the comic, the blob, the leaderboard row, the permanent
    /// archive entry and every user's kept copy, none of which comes back.
    /// </summary>
    private async Task ConfirmRemoveAsync(ModerationItemDto item)
    {
        var confirmed = await Dialogs.Confirm(
            "Erase the comic, its image, its leaderboard and archive entries, and every kept copy? This cannot be undone.",
            $"Remove {(string.IsNullOrWhiteSpace(item.RestaurantName) ? item.PlaceId : item.RestaurantName)}?",
            new ConfirmOptions { OkButtonText = "Yes, remove", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await ActAsync(item, ModerationAction.Remove);
        }
    }

    private async Task ActAsync(ModerationItemDto item, ModerationAction action)
    {
        _isBusy = true;
        _error = null;

        try
        {
            var task = action switch
            {
                ModerationAction.Hide => ModerationApi.HideAsync(item.PlaceId, "Hidden from the moderation queue."),
                ModerationAction.Restore => ModerationApi.RestoreAsync(item.PlaceId, "Reviewed and cleared."),
                ModerationAction.Suppress => ModerationApi.SuppressAsync(item.PlaceId, "Suppressed from the moderation queue."),
                _ => ModerationApi.RemoveAsync(item.PlaceId, "Removed from the moderation queue.")
            };

            await task;

            // Played only once the call has actually landed.
            await Fx.PlayConfirmAsync();

            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            // Said plainly. A moderator who believes an action landed when it did not will move
            // on and leave content up.
            _error = "That action did not go through. Nothing was changed — please try again.";
            await Fx.PlayErrorAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }
}
