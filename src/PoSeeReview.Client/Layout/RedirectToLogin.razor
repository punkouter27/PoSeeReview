@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Only a local, base-relative path ever leaves the client (open-redirect guard;
        // the server re-validates in /auth/* — NET_RULES 4.4).
        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(relativePath)}");
    }
}
