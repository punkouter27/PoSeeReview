@using System.Security.Claims
@using PoSeeReview.Client.Services
@inject ApiClient ApiClient
@inject DiscoveryState Discovery

@* The Po shell header (Po web standard): the app name upper-left, then the signed-in email (or
   the Sign in button) and the settings gear upper-right. One header on every page, signed in
   and out — BareLayout renders it too, with the nav hidden. Styled by po-tokens.css. *@
<header class="po-header">
    @* Home is the landing, not the last search: discovery restores its results otherwise. *@
    <a class="po-header__title navbar-brand" href="/" @onclick="Discovery.Clear">
        <svg class="brand-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.9" stroke="currentColor" stroke-width="0.5"/>
            <rect x="15" y="1" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.7" stroke="currentColor" stroke-width="0.5"/>
            <rect x="1" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.7" stroke="currentColor" stroke-width="0.5"/>
            <rect x="15" y="15" width="11" height="11" rx="2" fill="currentColor" fill-opacity="0.5" stroke="currentColor" stroke-width="0.5"/>
        </svg>
        <span class="brand-name">PoSeeReview</span>
    </a>

    @if (_isMockData)
    {
        <span class="nav-mock-badge" title="Running with mock data — no real AI or storage connections">USING MOCK DATA</span>
    }

    @if (ShowNav)
    {
        <nav class="nav-links" aria-label="Primary navigation">
            @* No Home item: the title is the way home. On a phone the bottom nav carries it. *@
            <div class="nav-item">
                <NavLink class="nav-link" href="leaderboard">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 2a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v1a3.5 3.5 0 0 1-3.362 3.496A5.002 5.002 0 0 1 8.5 10.9V12h2a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1h2v-1.1a5.002 5.002 0 0 1-2.138-4.404A3.5 3.5 0 0 1 2 3V2Zm1 1a2.5 2.5 0 0 0 2.45 2.5A5.03 5.03 0 0 1 5 3H3Zm8 0a5.03 5.03 0 0 1-.45 2.5A2.5 2.5 0 0 0 13 3h-2Z"/></svg>
                    <span class="nav-label">Hall of Fame</span>
                </NavLink>
            </div>
        </nav>
    }

    <div class="po-header__actions">
        <AuthorizeView>
            <Authorized Context="auth">
                <span class="po-header__email" title="@EmailOf(auth.User)">@EmailOf(auth.User)</span>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary po-header__signin" href="login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
        @* Settings, My comics and Sign out all live on /settings. *@
        <a class="po-header__settings" href="/settings" aria-label="Settings" title="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
    </div>
</header>

@code {
    /// <summary>False on BareLayout (the sign-in page), where the nav only bounced back to it.</summary>
    [Parameter] public bool ShowNav { get; set; } = true;

    private bool _isMockData;

    protected override async Task OnInitializedAsync() =>
        _isMockData = (await ApiClient.GetMockStatusAsync())?.IsMockActive ?? false;

    /// <summary>The header shows the email, never a display name; the name is a last resort.</summary>
    public static string EmailOf(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? "Signed in";
}
