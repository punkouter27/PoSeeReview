@* The one place Radzen is switched on. Operator pages wrap their content in this; it loads the
   theme and script (js/radzen-theme.js) before rendering any Radzen component, which calls into
   that script on first render. Dialogs opened through DialogService render here too, so nothing
   Radzen reaches the consumer layout. *@
@using Radzen.Blazor
@inject IJSRuntime JS

@if (_ready)
{
    <RadzenDialog />
    @ChildContent
}
else
{
    <LoadingIndicator Message="Loading..." />
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/radzen-theme.js");
            await module.InvokeVoidAsync("load");
        }
        catch (JSException)
        {
            // Offline or blocked: the components still work, just unstyled.
        }

        _ready = true;
        StateHasChanged();
    }
}
