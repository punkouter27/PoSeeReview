@* The Po build stamp: v{YYMMDD} (the HEAD commit's UTC date), bottom-right on every page, so a
   screenshot or a bug report says which deploy it came from. Stamped into every assembly by the
   StampBuildDate target in Directory.Build.targets; /api/diag reports the same value. Styled by
   po-tokens.css (.po-version). *@
@using System.Reflection

@if (Stamp is not null)
{
    <span class="po-version" title="Build version (vYYMMDD)">v@(Stamp)</span>
}

@code {
    /// <summary>The raw YYMMDD, also shown on /settings.</summary>
    public static readonly string? Stamp = typeof(BuildVersion).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildStamp")?.Value;
}
