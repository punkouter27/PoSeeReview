@*
    One page container and header, replacing five hand-rolled ones.

    The header is one row: title on the left, the page's own controls (scope chips, a clear
    button) on the right, wrapping under it on a phone. It used to be a centred title over a
    subtitle — and on the Hall of Fame a gradient hero banner — which spent 150–250px above the
    fold restating what the title and the nav already said. Pages that genuinely differ (Login's
    centred card, discovery's search) do not use this at all.
*@
<div class="page-shell @WidthClass @Class">
    <header class="page-shell-header">
        <h1 class="page-shell-title">@Title</h1>
        @Header
    </header>

    @ChildContent
</div>

@code {
    public enum ShellWidth
    {
        /// <summary>Reading width — forms and single-column content.</summary>
        Narrow,

        /// <summary>Default. Card grids and lists.</summary>
        Standard,

        /// <summary>Dense data views that genuinely benefit from the extra room.</summary>
        Wide
    }

    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    [Parameter] public ShellWidth Width { get; set; } = ShellWidth.Standard;

    /// <summary>Page controls, placed on the title row.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional classes, so a page can still attach its own scoped styling.</summary>
    [Parameter] public string? Class { get; set; }

    private string WidthClass => Width switch
    {
        ShellWidth.Narrow => "page-shell--narrow",
        ShellWidth.Wide => "page-shell--wide",
        _ => string.Empty
    };
}
