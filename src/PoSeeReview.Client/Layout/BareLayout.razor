@inherits LayoutComponentBase

@* For pages that are the whole screen — Login. MainLayout's nav offered Hall of Fame there,
   and it only bounced back to the login page. The boundary is kept: without it a
   login-page exception shows the framework's red strip instead of a way forward. *@
<main id="main-content">
    <ErrorBoundary>
        <ChildContent>@Body</ChildContent>
        <ErrorContent><ErrorPanel /></ErrorContent>
    </ErrorBoundary>
</main>

<BuildVersion />
