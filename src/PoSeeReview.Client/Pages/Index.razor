@page "/"
@attribute [Authorize]
@implements IDisposable
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using Microsoft.JSInterop
@using System.Net
@inject GeolocationService GeolocationService
@inject IJSRuntime JS
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject FxService Fx
@inject DiscoveryState Discovery
@inject ToastService Toast
@inject ComicHistoryService History

<PageTitle>PoSeeReview - Discover Strange Restaurant Stories</PageTitle>

<div class="index-container">
    @* The landing is two columns on a desktop: the search on the left, what the app has already
       drawn on the right. A single centred search bar used to leave half of a 768px fold empty. *@
    <div class="discovery-head @(ShowLanding && HasLandingSide ? "discovery-head--split" : "")">
        <div class="discovery-search">
            @* One line of hero, and it says what the app does — the nav already carries the
               wordmark. Hidden once results are showing; the page keeps its h1 either way. *@
            @if (_restaurants.Count == 0)
            {
                <header class="app-header">
                    <h1>Turn a restaurant's wildest reviews into a comic</h1>
                </header>
            }
            else
            {
                <h1 class="visually-hidden">PoSeeReview</h1>
            }

            @* The error sits ABOVE the search bar, and the bar stays mounted in the Error state — a
               failed text search must leave the user their search box, not a lone "Try again" link. *@
            @if (_flowState == LocationFlowState.Error)
            {
                <div class="alert alert-danger error-message" role="alert">
                    <span>@_errorMessage</span>
                    <button type="button" class="btn btn-secondary retry-link" @onclick="RetryLastAttemptAsync">@RetryLabel</button>
                </div>
            }

            @* One bar in every state. With results it turns compact and carries what used to be a
               separate row — the query (edit it and search again), a clear button that replaced
               "New search", the count and the List/Map switch. Its "Near me" is the map's too:
               with the map showing it searches quietly and keeps the pins on screen. *@
            <div class="location-prompt glass @(HasResults ? "location-prompt--compact" : "")">
                <div class="search-row">
                    @if (_flowState != LocationFlowState.Denied)
                    {
                        <button type="button" class="btn btn-primary location-btn"
                                disabled="@IsBusy"
                                @onclick="NearMeAsync"
                                title="Use my location" aria-label="Use my location">
                            <span aria-hidden="true">📍</span>
                            <span class="location-btn-label">@(IsLocating ? "Finding you..." : "Near me")</span>
                        </button>
                    }
                    <label for="city-search-input" class="visually-hidden">Search city, address, or ZIP code</label>
                    <input id="city-search-input" class="search-field" type="search" autocomplete="off" enterkeyhint="search"
                           @ref="_searchInput"
                           @bind="_searchQuery" @bind:event="oninput" placeholder="@_searchPlaceholder" @onkeydown="HandleSearchKeyDown" />
                    @* Clears the text only; the results stay. The brand link is the way back to the landing. *@
                    @if (!string.IsNullOrEmpty(_searchQuery))
                    {
                        <button type="button" class="btn btn-secondary btn-icon clear-search-btn" @onclick="ClearQueryAsync"
                                title="Clear the search box" aria-label="Clear the search box">
                            <span aria-hidden="true">&#215;</span>
                        </button>
                    }
                    <button type="button" class="btn btn-secondary"
                            @onclick="SearchByLocationAsync"
                            disabled="@(IsBusy || string.IsNullOrWhiteSpace(_searchQuery))"
                            title="@(string.IsNullOrWhiteSpace(_searchQuery) ? "Type a city, address, or ZIP code first" : "Search this location")">
                        @(IsTextSearching ? "Searching..." : "Search")
                    </button>
                    @if (HasResults)
                    {
                        <div class="results-meta">
                            <span class="results-count">@_restaurants.Count restaurant@(_restaurants.Count == 1 ? "" : "s") found</span>
                            @if (!_mapUnavailable)
                            {
                                <div class="layout-toggle" role="group" aria-label="Show results as">
                                    <button type="button" class="chip-toggle @(_layout == ResultsLayout.List ? "chip-toggle--active" : "")"
                                            aria-pressed="@(_layout == ResultsLayout.List ? "true" : "false")"
                                            @onclick="() => SetLayoutAsync(ResultsLayout.List)">List</button>
                                    <button type="button" class="chip-toggle @(_layout == ResultsLayout.Map ? "chip-toggle--active" : "")"
                                            aria-pressed="@(_layout == ResultsLayout.Map ? "true" : "false")"
                                            @onclick="() => SetLayoutAsync(ResultsLayout.Map)">Map</button>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (_flowState == LocationFlowState.Denied)
                {
                    <p class="denied-alert" role="alert">
                        📍 Location access was denied — search above, or
                        <button type="button" class="link-button" @onclick="RequestLocationAsync">try location again</button>.
                    </p>
                }
            </div>
        </div>

        @* The fold used to be blank below the search bar. The live board shows a first-time visitor
           what the app makes before they have to share a location, and a returning one gets their
           own recent comics back without opening the account menu. *@
        @if (ShowLanding && HasLandingSide)
        {
            <aside class="landing-side" aria-label="Already drawn">
                <section class="landing-board" aria-labelledby="landing-board-title">
                    <div class="landing-board-head">
                        <h2 id="landing-board-title" class="comic-rows-heading">@LandingTitle</h2>
                        <a href="@(ShowingTop ? "/leaderboard" : "/my-comics")">@(ShowingTop ? "Hall of Fame →" : "My comics →")</a>
                    </div>
                    @if (HasTop && HasRecent)
                    {
                        <div class="layout-toggle" role="group" aria-label="Show">
                            <button type="button" class="chip-toggle @(_landingTab == LandingTab.Strangest ? "chip-toggle--active" : "")"
                                    aria-pressed="@(_landingTab == LandingTab.Strangest ? "true" : "false")"
                                    @onclick="() => _landingTab = LandingTab.Strangest">Strangest</button>
                            <button type="button" class="chip-toggle @(_landingTab == LandingTab.Recent ? "chip-toggle--active" : "")"
                                    aria-pressed="@(_landingTab == LandingTab.Recent ? "true" : "false")"
                                    @onclick="() => _landingTab = LandingTab.Recent">Recent</button>
                        </div>
                    }
                    @if (ShowingTop)
                    {
                        <ol class="comic-rows comic-rows--stack">
                            @foreach (var entry in _topComics!)
                            {
                                <ComicRow Href="@($"/comic/{entry.PlaceId}")"
                                          Name="@entry.RestaurantName"
                                          Score="@((int)Math.Round(entry.StrangenessScore))"
                                          ImageUrl="@ComicImageUrl.For(entry.ComicBlobUrl, entry.PlaceId)"
                                          Meta="@entry.Address" />
                            }
                        </ol>
                    }
                    else
                    {
                        <ul class="comic-rows comic-rows--stack">
                            @foreach (var entry in _recent!)
                            {
                                <ComicRow Href="@($"/comic/{entry.PlaceId}")"
                                          Name="@entry.RestaurantName"
                                          Score="@entry.StrangenessScore"
                                          ImageUrl="@ComicImageUrl.SameOrigin(entry.PlaceId)"
                                          Meta="@RelativeTime.Format(entry.ViewedAt)" />
                            }
                        </ul>
                    }
                </section>
            </aside>
        }
    </div>

    @if (_flowState == LocationFlowState.Loading && !HasResults)
    {
        <p class="results-info" role="status">@_loadingMessage</p>
        @* Shaped like what is about to land, so nothing jumps when it does: the map and its cards
           when the map is the remembered view, the card grid when it is the list. *@
        @if (_layout == ResultsLayout.Map && !_mapUnavailable)
        {
            <div class="discovery-split" aria-hidden="true">
                <div class="map-skeleton sk-block"></div>
                <div class="results-pane">
                    <div class="results-pane-list">
                        @for (var i = 0; i < 3; i++)
                        {
                            @SkeletonCard
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="restaurants-grid" aria-hidden="true">
                @for (var i = 0; i < 6; i++)
                {
                    @SkeletonCard
                }
            </div>
        }
    }

    @if (HasResults)
    {
        @if (_layout == ResultsLayout.Map)
        {
            @* Map and cards side by side on a desktop, stacked on a phone. A pin only selects; the
               card is the same card the list shows, so the tap that opens (or pays for) a comic is
               still the card's own button. The picked place moves to the top of the cards. *@
            <div class="discovery-split">
                <MapView Pins="@MapPins" SelectedId="@_selectedPlaceId" Label="Restaurants on a map"
                         Origin="@_me" KeepCamera="@_keepCamera"
                         OnSelect="SelectPlace" OnAreaMoved="AreaMovedAsync"
                         OnUnavailable="MapUnavailable">
                    <Overlay>
                        @if (_movedTo is { } area)
                        {
                            if (area.Zoom >= MinSearchZoom)
                            {
                                <button type="button" class="btn btn-primary map-overlay-btn" disabled="@_areaSearching"
                                        @onclick="SearchThisAreaAsync">
                                    @(_areaSearching ? "Searching..." : "Search this area")
                                </button>
                            }
                            else
                            {
                                <span class="map-overlay-hint">Zoom in to search here</span>
                            }
                        }
                    </Overlay>
                </MapView>
                <section class="results-pane" aria-labelledby="pane-title">
                    <div class="nearest-head">
                        <h2 id="pane-title" class="comic-rows-heading">@PaneTitle</h2>
                        <p class="results-info">@(_cachedScores.Count > 0 ? "Numbered pins are already drawn and open free." : "Tap a pin to pick a place.")</p>
                    </div>
                    <div class="results-pane-list">
                        @foreach (var restaurant in PanePicks)
                        {
                            <RestaurantCard
                                @key="restaurant.PlaceId"
                                Restaurant="restaurant"
                                IsCached="@_cachedScores.ContainsKey(restaurant.PlaceId)"
                                Forecast="@ForecastFor(restaurant.PlaceId)"
                                ForecastFloor="@_forecastFloor"
                                IsLoading="@(_isNavigatingToComic && _activeComicPlaceId == restaurant.PlaceId)"
                                OnRestaurantClick="HandleRestaurantClick" />
                        }
                    </div>
                    @* A phone shows the closest three under the map; the rest are one tap away. *@
                    @if (PanePicks.Count > PhonePaneCount)
                    {
                        <button type="button" class="btn btn-secondary pane-show-all" @onclick="() => SetLayoutAsync(ResultsLayout.List)">
                            Show all @_restaurants.Count as a list
                        </button>
                    }
                </section>
            </div>
        }
        else
        {
            <div class="restaurants-grid">
                @foreach (var restaurant in _restaurants)
                {
                    <RestaurantCard
                        Restaurant="restaurant"
                        IsCached="@_cachedScores.ContainsKey(restaurant.PlaceId)"
                        Forecast="@ForecastFor(restaurant.PlaceId)"
                        ForecastFloor="@_forecastFloor"
                        IsLoading="@(_isNavigatingToComic && _activeComicPlaceId == restaurant.PlaceId)"
                        OnRestaurantClick="HandleRestaurantClick" />
                }
            </div>
        }
    }
</div>

@code {
    private enum LocationFlowState { Idle, Loading, Denied, Error, Ready }

    /// <summary>Which entry point produced the current results, so a retry repeats it.</summary>
    private enum DiscoveryAttempt { None, Location, Search }

    private LocationFlowState _flowState = LocationFlowState.Idle;
    private DiscoveryAttempt _lastAttempt = DiscoveryAttempt.None;
    private string _loadingMessage = "Getting your location...";
    private string _errorMessage = string.Empty;
    private List<RestaurantDto> _restaurants = new();

    /// <summary>A text search lives in the URL, so it survives Back, refresh and a shared link.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }
    private string _searchQuery = string.Empty;
    private ElementReference _searchInput;
    private string _searchPlaceholder = "City or ZIP";
    private string _lastSearch = string.Empty;
    private bool _isNavigatingToComic;
    private string? _activeComicPlaceId;

    /// <summary>Live comic score per place that already has one; absent means not drawn yet.</summary>
    private Dictionary<string, int> _cachedScores = [];
    private Dictionary<string, int> _forecasts = [];
    private int _forecastFloor;
    private List<LeaderboardEntryDto>? _topComics;

    private enum ResultsLayout { List, Map }

    /// <summary>Which list the landing's single "Already drawn" panel shows.</summary>
    private enum LandingTab { Strangest, Recent }

    private LandingTab _landingTab = LandingTab.Strangest;

    private const string LayoutKey = "posee_discovery_layout";

    /// <summary>The map is the default view; the list is the remembered alternative.</summary>
    private ResultsLayout _layout = ResultsLayout.Map;
    private string? _selectedPlaceId;

    /// <summary>Where the current results were measured from, which decides what "nearest" means.</summary>
    private enum ResultsOrigin { Me, Text, Area }

    private ResultsOrigin _origin = ResultsOrigin.Me;

    /// <summary>The user's position from their last location request, for the map's dot.</summary>
    private (double Lat, double Lng)? _me;

    /// <summary>Set once the user pans or zooms; offers "search this area" until it is used.</summary>
    private MapArea? _movedTo;

    /// <summary>
    /// Below this the view spans a region, and the search radius (5 km around the centre) would
    /// look like it ignored most of what is on screen.
    /// </summary>
    private const double MinSearchZoom = 11;

    private bool _areaSearching;
    private bool _keepCamera;

    /// <summary>No WebGL (or the CDN is blocked): the list for the rest of the visit, not remembered.</summary>
    private bool _mapUnavailable;

    private bool HasResults => _restaurants.Count > 0;

    /// <summary>The landing: nothing searched yet, or the first search did not land.</summary>
    private bool ShowLanding => !HasResults && _flowState is LocationFlowState.Idle or LocationFlowState.Denied or LocationFlowState.Error;

    private bool HasTop => _topComics is { Count: > 0 };
    private bool HasRecent => _recent is { Count: > 0 };
    private bool HasLandingSide => HasTop || HasRecent;

    /// <summary>The landing panel shows the board unless only history exists or the user picked Recent.</summary>
    private bool ShowingTop => HasTop && (!HasRecent || _landingTab == LandingTab.Strangest);

    private string LandingTitle => HasTop && HasRecent ? "Already drawn" : HasTop ? "Strangest right now" : "Your recent comics";

    private bool IsBusy => _flowState == LocationFlowState.Loading || _areaSearching;

    /// <summary>Each button reports only its own search — a text search used to read "Finding you...".</summary>
    private bool IsLocating => _flowState == LocationFlowState.Loading && _lastAttempt == DiscoveryAttempt.Location;

    private bool IsTextSearching => _flowState == LocationFlowState.Loading && _lastAttempt == DiscoveryAttempt.Search;

    /// <summary>Cards a phone shows under the map; a desktop shows them all beside it.</summary>
    private const int PhonePaneCount = 3;

    private string PaneTitle => _origin == ResultsOrigin.Me ? "Nearest to you" : "In this area";

    /// <summary>Drawable places nearest first, with the picked pin's place moved to the top.</summary>
    private List<RestaurantDto> PanePicks =>
        [.. _restaurants.Where(r => r.TotalReviews > 0).OrderBy(r => r.PlaceId == _selectedPlaceId ? 0 : 1)];

    /// <summary>With the map up, "Near me" searches quietly and keeps the pins; otherwise it is the first search.</summary>
    private Task NearMeAsync() => HasResults && _layout == ResultsLayout.Map && !_mapUnavailable
        ? LocateOnMapAsync()
        : RequestLocationAsync();

    private List<ComicHistoryEntry>? _recent;

    /// <summary>This browser's last few live comics, for the landing. Expired ones would open on a paid redraw.</summary>
    private async Task LoadRecentAsync() =>
        _recent = [.. (await History.GetAllAsync()).Where(e => !e.IsExpired).Take(3)];

    /// <summary>The card skeleton, sized like a RestaurantCard. A fragment so it keeps this page's scoped CSS.</summary>
    private RenderFragment SkeletonCard =>
        @<div class="skeleton-card">
            <div class="sk-row">
                <div class="sk-block sk-title"></div>
                <div class="sk-block sk-badge"></div>
            </div>
            <div class="sk-block sk-text sk-address"></div>
            <div class="sk-block sk-text sk-meta"></div>
            <div class="sk-block sk-btn"></div>
        </div>;

    private void MapUnavailable()
    {
        _mapUnavailable = true;
        _layout = ResultsLayout.List;
    }

    /// <summary>A user pan or zoom. "Search this area" appearing pings, when map sounds are on.</summary>
    private async Task AreaMovedAsync(MapArea area)
    {
        var wasOffered = _movedTo is { Zoom: >= MinSearchZoom };
        _movedTo = area;
        if (!wasOffered && area.Zoom >= MinSearchZoom)
        {
            await Fx.PlayMapPingAsync();
        }
    }

    /// <summary>Re-runs nearby search at the map's centre, leaving the camera where the user put it.</summary>
    private Task SearchThisAreaAsync() =>
        _movedTo is { } area ? QuietNearbyAsync(area.Lat, area.Lng, ResultsOrigin.Area) : Task.CompletedTask;

    /// <summary>"Near me" from the map: locate, then search around the user without leaving the map.</summary>
    private async Task LocateOnMapAsync()
    {
        await Fx.UnlockAudioAsync();
        _areaSearching = true;
        var position = await GeolocationService.GetCurrentPositionAsync();
        if (!position.Success)
        {
            _areaSearching = false;
            Toast.Show(position.PermissionDenied
                ? "Location is off. Pan the map and search this area instead."
                : "Couldn't find your location. Try again.");
            await Fx.PlayErrorAsync();
            return;
        }

        _me = (position.Latitude, position.Longitude);
        await QuietNearbyAsync(position.Latitude, position.Longitude, ResultsOrigin.Me);
    }

    /// <summary>
    /// A nearby search from the map. Unlike the first search it keeps the current results on
    /// screen while it runs, and a miss is a toast — the map and its pins stay put rather than
    /// being replaced by an error state.
    /// </summary>
    private async Task QuietNearbyAsync(double latitude, double longitude, ResultsOrigin origin)
    {
        _areaSearching = true;
        StateHasChanged();
        try
        {
            var response = await ApiClient.GetNearbyRestaurantsAsync(latitude, longitude);
            if (response is null || response.Stale || response.Restaurants.Count == 0)
            {
                Toast.Show(response?.Stale == true
                    ? response.StaleReason ?? "Restaurant search is temporarily unavailable."
                    : "No restaurants found here. Try another spot.");
                await Fx.PlayEmptyAsync();
                return;
            }

            _keepCamera = origin == ResultsOrigin.Area;
            SetRestaurantResults(response.Restaurants);
            if (origin == ResultsOrigin.Area)
            {
                // Measured from the map's centre, not from the user: "120m away" would be a lie.
                foreach (var restaurant in _restaurants)
                {
                    restaurant.Distance = 0;
                }
            }

            _origin = origin;
            _movedTo = null;
            await AfterResultsAsync(query: null);
        }
        catch (Exception ex)
        {
            Toast.Show(DescribeFailure(ex, DiscoveryAttempt.Location, string.Empty));
            await Fx.PlayErrorAsync();
        }
        finally
        {
            _areaSearching = false;
        }
    }

    /// <summary>
    /// Places that can be drawn and have a real location. A zero-review place has nothing to draw
    /// from, so a pin for it would be a tap that leads nowhere.
    /// </summary>
    private List<MapPin> MapPins =>
    [
        .. _restaurants
            .Where(r => r.TotalReviews > 0 && MapPin.HasCoordinates(r.Latitude, r.Longitude))
            .Select(r => new MapPin
            {
                Id = r.PlaceId,
                Name = r.Name,
                Lat = r.Latitude,
                Lng = r.Longitude,
                Score = _cachedScores.TryGetValue(r.PlaceId, out var score) ? score : null,
                Label = _cachedScores.TryGetValue(r.PlaceId, out var s)
                    ? $"{r.Name}, strangeness {s}, comic ready"
                    : ForecastFor(r.PlaceId) is { } forecast
                        ? $"{r.Name}, not drawn yet, forecast strangeness {forecast}"
                        : $"{r.Name}, not drawn yet"
            })
    ];

    private void SelectPlace(string placeId) => _selectedPlaceId = placeId;

    /// <summary>The choice outlives the visit; storage that throws just means it is not remembered.</summary>
    private async Task SetLayoutAsync(ResultsLayout layout)
    {
        _layout = layout;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", LayoutKey, layout == ResultsLayout.Map ? "map" : "list");
        }
        catch (JSException) { }
    }

    private async Task RestoreLayoutAsync()
    {
        try
        {
            _layout = await JS.InvokeAsync<string?>("localStorage.getItem", LayoutKey) == "list" ? ResultsLayout.List : ResultsLayout.Map;
        }
        catch (JSException) { }
    }

    /// <summary>
    /// Asks which of the current results are already drawn.
    /// <para>
    /// A cached comic opens instantly and costs nothing, a fresh one spends a paid generation and
    /// about ten seconds.
    /// </para>
    /// </summary>
    private async Task RefreshCachedPlacesAsync()
    {
        var probe = _restaurants.Count == 0
            ? new CachedComicsResponse()
            : await ApiClient.GetComicProbeAsync(_restaurants.Select(r => r.PlaceId));

        _cachedScores = probe.CachedPlaceIds.ToDictionary(id => id, id => probe.Scores.GetValueOrDefault(id), StringComparer.Ordinal);
        _forecasts = probe.Forecasts;
        _forecastFloor = probe.ForecastFloor;
    }

    /// <summary>The cached forecast for an undrawn place, or null when nobody has tried it under this prompt.</summary>
    private int? ForecastFor(string placeId) =>
        !_cachedScores.ContainsKey(placeId) && _forecasts.TryGetValue(placeId, out var score) ? score : null;

    /// <summary>Best-effort: the landing page works without it, so a failure just hides it.</summary>
    private async Task LoadTopComicsAsync()
    {
        try
        {
            var board = await ApiClient.GetLeaderboardAsync(string.Empty, 5);
            _topComics = board?.Entries.Where(e => !string.IsNullOrWhiteSpace(e.ComicBlobUrl)).ToList();
            StateHasChanged();
        }
        catch (Exception)
        {
            _topComics = null;
        }
    }

    private const string LastSearchKey = "posee_last_search";
    private const string DiscoveryModeKey = "posee_discovery_mode";
    private const string GeoMode = "geo";
    private const string ZipMode = "zip";

    /// <summary>
    /// Resumes whichever entry point the user last completed successfully. A remembered ZIP or
    /// city is re-run and left in the box, so typing a location is a real alternative to sharing
    /// GPS rather than something the app forgets between visits. With nothing remembered the page
    /// stays Idle and requests no permission — the card is the first thing the user sees.
    /// <para>
    /// Coming Back from a comic is neither: the results are still in <see cref="DiscoveryState"/>
    /// and go straight back on screen, with no refetch, skeletons, locating cue or permission prompt.
    /// </para>
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Discovery.Cleared += OnDiscoveryCleared;
        await RestoreLayoutAsync();

        if (Discovery.Restaurants.Count > 0 && (Q is null || Q == Discovery.Query))
        {
            _restaurants = Discovery.Restaurants;
            _searchQuery = _lastSearch = Discovery.Query ?? string.Empty;
            _lastAttempt = Discovery.Query is null ? DiscoveryAttempt.Location : DiscoveryAttempt.Search;
            _origin = Discovery.Query is not null ? ResultsOrigin.Text
                : _restaurants.Any(r => r.Distance > 0) ? ResultsOrigin.Me : ResultsOrigin.Area;
            _flowState = LocationFlowState.Ready;

            // The one thing that may have changed while away: the comic just drawn is now free.
            await RefreshCachedPlacesAsync();
            return;
        }

        _ = LoadTopComicsAsync();
        await LoadRecentAsync();

        if (!string.IsNullOrWhiteSpace(Q))
        {
            _searchQuery = Q;
            await SearchByLocationAsync();
            return;
        }

        var lastLocation = await JS.InvokeAsync<string?>("localStorage.getItem", LastSearchKey);
        if (!string.IsNullOrWhiteSpace(lastLocation))
        {
            _searchPlaceholder = $"Last: {lastLocation}";
        }

        switch (await JS.InvokeAsync<string?>("localStorage.getItem", DiscoveryModeKey))
        {
            case ZipMode when !string.IsNullOrWhiteSpace(lastLocation):
                _searchQuery = lastLocation!;
                await SearchByLocationAsync();
                break;
            case GeoMode:
                await RequestLocationAsync();
                break;
        }
    }

    private Task RememberDiscoveryModeAsync(string mode) =>
        JS.InvokeVoidAsync("localStorage.setItem", DiscoveryModeKey, mode).AsTask();

    /// <summary>
    /// Disarms the geolocation entry point after a refusal so the next visit does not re-prompt
    /// for a permission the browser already denied. A remembered ZIP is deliberately left intact:
    /// the user declining GPS is not the user abandoning the location they typed.
    /// </summary>
    private async Task ForgetGeoPreferenceAsync()
    {
        var mode = await JS.InvokeAsync<string?>("localStorage.getItem", DiscoveryModeKey);
        if (mode is null or GeoMode)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", DiscoveryModeKey);
        }
    }

    private string RetryLabel => _lastAttempt == DiscoveryAttempt.Search
        ? $"Search “{_lastSearch}” again"
        : "Try my location again";

    /// <summary>
    /// Repeats whichever discovery path failed. Retrying a failed text search by asking for
    /// geolocation — what the old single "Try again" link did — is a different action than
    /// the one the user took.
    /// </summary>
    private Task RetryLastAttemptAsync() => _lastAttempt == DiscoveryAttempt.Search
        ? SearchByLocationAsync()
        : RequestLocationAsync();

    private async Task RequestLocationAsync()
    {
        // First trusted gesture on the landing page: the only moment a browser will let the
        // AudioContext start.
        await Fx.UnlockAudioAsync();
        // A ping with a delayed echo rather than a click. The gap is the whole message — a
        // request has gone out and has not come back — and a plain tap said nothing the button's
        // own press state did not already say.
        await Fx.PlayLocatingAsync();

        _lastAttempt = DiscoveryAttempt.Location;
        _keepCamera = false;
        _flowState = LocationFlowState.Loading;
        _loadingMessage = "Getting your location...";
        StateHasChanged();

        try
        {
            var result = await GeolocationService.GetCurrentPositionAsync();

            if (!result.Success)
            {
                if (result.PermissionDenied)
                {
                    _flowState = LocationFlowState.Denied;
                    await ForgetGeoPreferenceAsync();
                }
                else
                {
                    Fail(result.ErrorMessage);
                    await Fx.PlayErrorAsync();
                }

                return;
            }

            _me =(result.Latitude, result.Longitude);
            _origin = ResultsOrigin.Me;
            await RememberDiscoveryModeAsync(GeoMode);

            _loadingMessage = "Finding nearby restaurants...";
            StateHasChanged();

            await LoadNearbyRestaurantsAsync(result.Latitude, result.Longitude);
        }
        catch (Exception)
        {
            Fail("Unable to access your location. Please try again.");
            await Fx.PlayErrorAsync();
        }
        finally
        {
            if (_flowState == LocationFlowState.Loading)
                _flowState = LocationFlowState.Ready;
            StateHasChanged();
        }
    }

    private async Task LoadNearbyRestaurantsAsync(double latitude, double longitude)
    {
        try
        {
            var response = await ApiClient.GetNearbyRestaurantsAsync(latitude, longitude);

            if (response == null)
            {
                await FailEmptyAsync("No restaurants found nearby. Try a different location.");
                return;
            }

            if (response.Stale)
            {
                // Dev short-circuit or upstream unavailable — explain the why instead of "no results".
                Fail(response.StaleReason
                    ?? "Restaurant search is temporarily unavailable. " +
                       "Add a real Google Maps API key to appsettings.Development.json to enable nearby search.");
                return;
            }

            if (response.Restaurants.Count == 0)
            {
                await FailEmptyAsync("No restaurants found nearby. Try a different location.");
                return;
            }

            SetRestaurantResults(response.Restaurants);
            _flowState = LocationFlowState.Ready;
            await AfterResultsAsync(query: null);
        }
        catch (Exception ex)
        {
            Fail(DescribeFailure(ex, DiscoveryAttempt.Location, string.Empty));
            await Fx.PlayErrorAsync();
        }
    }

    private async Task SearchByLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;

        var searchTerm = _searchQuery.Trim();

        await Fx.UnlockAudioAsync();
        await Fx.PlayLocatingAsync();

        _lastAttempt = DiscoveryAttempt.Search;
        _keepCamera = false;
        _origin = ResultsOrigin.Text;
        _lastSearch = searchTerm;
        _flowState = LocationFlowState.Loading;
        _loadingMessage = $"Searching restaurants near {searchTerm}...";
        StateHasChanged();

        try
        {
            var response = await ApiClient.SearchRestaurantsByLocationAsync(searchTerm);

            if (response == null)
            {
                await FailEmptyAsync("No restaurants found for that location. Try a different city or ZIP code.");
                return;
            }

            // Same short-circuit the nearby path already handled. Without this a placeholder
            // Google Maps key reported "try a different city", sending the user chasing a
            // problem that has nothing to do with their query.
            if (response.Stale)
            {
                Fail(response.StaleReason
                    ?? "Restaurant search is temporarily unavailable. Please try again later.");
                return;
            }

            if (response.Restaurants.Count == 0)
            {
                await FailEmptyAsync("No restaurants found for that location. Try a different city or ZIP code.");
                return;
            }

            SetRestaurantResults(response.Restaurants);
            _flowState = LocationFlowState.Ready;
            await AfterResultsAsync(searchTerm);
            await JS.InvokeVoidAsync("localStorage.setItem", LastSearchKey, searchTerm);
            await RememberDiscoveryModeAsync(ZipMode);
            _searchQuery = searchTerm;
            _searchPlaceholder = $"Last: {searchTerm}";
        }
        catch (Exception ex)
        {
            Fail(DescribeFailure(ex, DiscoveryAttempt.Search, searchTerm));
            await Fx.PlayErrorAsync();
        }
        finally
        {
            if (_flowState == LocationFlowState.Loading)
                _flowState = LocationFlowState.Ready;
            StateHasChanged();
        }
    }

    /// <param name="query">The text searched; null for a location search.</param>
    private async Task AfterResultsAsync(string? query)
    {
        Discovery.Set(query, _restaurants);

        // replace: a search is a state of this page, not a page visit, so Back leaves discovery
        // rather than stepping through every search made on it.
        if (query != Q)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("q", query), replace: true);
        }

        await RefreshCachedPlacesAsync();
        await Fx.PlayArrivalAsync(_restaurants.Count);
    }

    /// <summary>
    /// A search that found nothing. Distinct from <see cref="Fail"/>'s other callers because it
    /// gets the flat two-note cue rather than the error cue — a zero-result search is an answer,
    /// not a malfunction, and sounding like a malfunction sends the user looking for a fault.
    /// </summary>
    private async Task FailEmptyAsync(string message)
    {
        Fail(message);
        await Fx.PlayEmptyAsync();
    }

    /// <summary>
    /// Moves the page into the Error state with a message. Every failure path set the same two
    /// fields, and forgetting the state assignment left the banner invisible behind a spinner.
    /// </summary>
    private void Fail(string message)
    {
        _errorMessage = message;
        _flowState = LocationFlowState.Error;
    }

    /// <summary>
    /// One exception-to-copy map for both discovery paths. Nearby and search previously carried
    /// near-identical catch ladders — about seventy duplicated lines that had already drifted
    /// (only search handled 404) and would drift again on the next change.
    /// <para>
    /// Note what is deliberately absent: the old generic <c>HttpRequestException</c> arm fell back
    /// to <c>ex.Message</c>, which put raw transport exception text on screen. That is neither
    /// useful to a user nor safe to show, so every arm now returns copy this app wrote.
    /// </para>
    /// </summary>
    private static string DescribeFailure(Exception exception, DiscoveryAttempt attempt, string searchTerm) =>
        exception switch
        {
            HttpRequestException { StatusCode: HttpStatusCode.NotFound } when attempt == DiscoveryAttempt.Search =>
                $"No restaurants found near “{searchTerm}”. Try a more specific city name or ZIP code.",

            HttpRequestException { StatusCode: HttpStatusCode.ServiceUnavailable or HttpStatusCode.BadGateway } =>
                "The restaurant search service is temporarily unavailable. Please try again in a few minutes.",

            HttpRequestException { StatusCode: HttpStatusCode.TooManyRequests } =>
                "Too many requests. Please wait a moment before trying again.",

            TaskCanceledException =>
                "The request timed out. Please check your connection and try again.",

            _ when attempt == DiscoveryAttempt.Search =>
                "Failed to search restaurants. Please try again later.",

            _ => "Failed to load restaurants. Please try again later."
        };


    private async Task HandleSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchByLocationAsync();
        }
    }

    private async Task HandleRestaurantClick(RestaurantDto restaurant)
    {
        if (_isNavigatingToComic)
        {
            return;
        }

        _isNavigatingToComic = true;
        _activeComicPlaceId = restaurant.PlaceId;
        // No tap cue here: RestaurantCard already played one, panned to where the tap landed.
        StateHasChanged();

        await Task.Yield();
        Navigation.NavigateTo($"/comic/{restaurant.PlaceId}?generate=true");
    }

    private async Task ClearQueryAsync()
    {
        _searchQuery = string.Empty;
        await _searchInput.FocusAsync();
    }

    /// <summary>The brand link cleared <see cref="DiscoveryState"/> while this page was showing results.</summary>
    private void OnDiscoveryCleared() => _ = InvokeAsync(async () =>
    {
        await ResetToLandingAsync();
        StateHasChanged();
    });

    public void Dispose() => Discovery.Cleared -= OnDiscoveryCleared;

    private async Task ResetToLandingAsync()
    {
        if (_topComics is null)
        {
            _ = LoadTopComicsAsync();
        }


        _cachedScores = [];
        _forecasts = [];
        _selectedPlaceId = null;
        _restaurants = new();
        _lastSearch = string.Empty;
        _searchQuery = string.Empty;
        _isNavigatingToComic = false;
        _activeComicPlaceId = null;
        _flowState = LocationFlowState.Idle;

        if (_recent is null)
        {
            await LoadRecentAsync();
        }
    }

    private void SetRestaurantResults(IEnumerable<RestaurantDto> restaurants)
    {
        // No client-side review threshold. This used to drop anything under 5 reviews while
        // the API's ComicOptions.MinimumReviewsRequired was 1, so the client hid places the
        // server would happily draw. The only genuinely unusable case — zero reviews — is
        // handled by RestaurantCard, which matches the server's floor.
        //
        // Nearest first, unconditionally. Proximity is the only order the grid offers now that
        // the sort chips are gone, and a single order belongs where the list is built rather
        // than in a projection the render has to remember to use.
        _restaurants = [.. restaurants.OrderBy(r => r.Distance)];
        _selectedPlaceId = null;

        if (_restaurants.Count == 0)
        {
            Fail("We couldn't find any restaurants there. Try a busier area.");
        }
    }

}
