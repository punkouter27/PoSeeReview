@page "/my-comics"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ComicHistoryService History
@inject FxService Fx
@inject IJSRuntime JS

<PageTitle>My Comics - PoSeeReview</PageTitle>

<PageShell Title="My Comics"
           Width="PageShell.ShellWidth.Wide"
           Class="my-comics-container">
    <Header>
        @if (_entries is { Count: > 0 })
        {
            <button type="button" class="btn btn-secondary" @onclick="() => _confirmingClear = true">Clear history</button>
        }
    </Header>
    <ChildContent>
    @if (_entries is null)
    {
        @* Shaped like the rows about to land, so nothing jumps when they do. *@
        <p class="visually-hidden" role="status">Loading your comics...</p>
        <ul class="comic-rows">
            @for (var i = 0; i < 4; i++)
            {
                <ComicRow Skeleton="true" Href="" Name="" />
            }
        </ul>
    }
    else if (_entries.Count == 0)
    {
        <StateCard Icon="📭" Title="Nothing here yet">
            <ChildContent>Comics you open show up here automatically. Go find a restaurant with questionable reviews.</ChildContent>
            <Actions><a href="/" class="btn btn-primary">Find restaurants</a></Actions>
        </StateCard>
    }
    else
    {
        @* The list never leaves the browser. Saying so plainly is the honest counterpart to
           storing it without asking, and it explains why it is empty on the user's other phone. *@
        <p class="my-comics-summary">
            @_entries.Count remembered@(_expiredCount > 0 ? $" · {_expiredCount} expired" : "")
            · stored only in this browser
        </p>
        <ul class="comic-rows">
            @foreach (var entry in _entries)
            {
                <ComicRow Href="@LinkFor(entry)"
                          Name="@entry.RestaurantName"
                          Score="@entry.StrangenessScore"
                          ImageUrl="@(entry.IsExpired ? null : ComicImageUrl.SameOrigin(entry.PlaceId))"
                          Meta="@(entry.IsExpired ? "expired — tap to redraw" : RelativeTime.Format(entry.ViewedAt))"
                          data-freshness="@entry.Freshness">
                    <Actions>
                        <button type="button" class="btn btn-icon comic-row-action"
                                @onclick="(e) => ForgetAsync(entry.PlaceId, e)"
                                title="@($"Forget {entry.RestaurantName}")"
                                aria-label="@($"Forget {entry.RestaurantName}")">
                            <span aria-hidden="true">×</span>
                        </button>
                    </Actions>
                </ComicRow>
            }
        </ul>
    }
    </ChildContent>
</PageShell>

@if (_confirmingClear)
{
    <dialog @ref="_clearDialog" class="clear-dialog" aria-labelledby="clear-title" @onclick="CancelClearAsync">
        <div class="clear-panel glass" @onclick:stopPropagation="true">
            <h2 id="clear-title" class="clear-title">Forget all of them?</h2>
            <p class="clear-body">Comics you've opened are remembered only in this browser. Clearing forgets them all here.</p>
            <div class="clear-actions">
                <button type="button" class="btn btn-primary" @onclick="ClearAsync">Yes, clear</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelClearAsync">Cancel</button>
            </div>
        </div>
    </dialog>
}

@code {
    private List<ComicHistoryEntry>? _entries;
    private bool _confirmingClear;
    private int _expiredCount;
    private ElementReference _clearDialog;
    private IJSObjectReference? _clearModule;
    private bool _clearModalActive;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_confirmingClear)
        {
            return;
        }

        try
        {
            _clearModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal.js");
            _clearModalActive = await _clearModule.InvokeAsync<bool>("open", _clearDialog, DotNetObjectReference.Create(this));
        }
        catch (JSException)
        {
            // The panel still renders and its buttons still work without the modal semantics.
        }
    }

    /// <summary>Raised by js/modal.js when Escape or the backdrop closes the native dialog.</summary>
    [JSInvokable]
    public Task OnNativeClearCloseAsync()
    {
        _confirmingClear = false;
        return Task.CompletedTask;
    }

    private async Task CancelClearAsync()
    {
        if (_clearModalActive && _clearModule is not null)
        {
            try
            {
                await _clearModule.InvokeVoidAsync("close", _clearDialog);
                return;
            }
            catch (JSException)
            {
                // Fall through to the plain flag below.
            }
        }

        _confirmingClear = false;
    }

    private async Task ReloadAsync()
    {
        _entries = await History.GetAllAsync();
        _expiredCount = _entries.Count(e => e.IsExpired);
    }

    /// <summary>
    /// An expired entry links straight into generation; a live one does not. An aged card is a
    /// one-tap prompt to redraw a place the user already showed interest in.
    /// </summary>
    private static string LinkFor(ComicHistoryEntry entry) =>
        entry.IsExpired
            ? $"/comic/{entry.PlaceId}?generate=true"
            : $"/comic/{entry.PlaceId}";

    private async Task ForgetAsync(string placeId, MouseEventArgs args)
    {
        await Fx.UnlockAudioAsync();
        await Fx.PlayTapAtAsync(args.ClientX);
        await History.RemoveAsync(placeId);
        await ReloadAsync();
    }

    private async Task ClearAsync()
    {
        _confirmingClear = false;

        if (_clearModalActive && _clearModule is not null)
        {
            try
            {
                await _clearModule.InvokeVoidAsync("close", _clearDialog);
            }
            catch (JSException)
            {
                // The flag above already tears the dialog down.
            }
        }

        await History.ClearAsync();
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_clearModule is not null)
        {
            try
            {
                await _clearModule.DisposeAsync();
            }
            catch (JSException)
            {
                // Page is going away anyway.
            }
        }
    }
}
