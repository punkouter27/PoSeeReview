@page "/comic/{PlaceId}"
@attribute [Authorize]
@implements IAsyncDisposable
@using PoSeeReview.Shared.Dtos
@using PoSeeReview.Shared.Enums
@using PoSeeReview.Client.Services
@using System.Threading
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject FxService Fx
@inject ComicHistoryService History
@inject IJSRuntime JS

<PageTitle>@(_comic?.RestaurantName ?? "Comic") - PoSeeReview</PageTitle>

<div class="comic-view">
    @if (_isLoading)
    {
        @* FocusOnNavigate looks for an h1, and the loading state had none. *@
        <h1 class="visually-hidden">@(_isGenerating ? "Drawing your comic" : "Loading comic")</h1>

        @* A generation shows the step it is on over the storyboard, which is itself the progress
           display — frames ink in as the pipeline advances. A cache read is a plain spinner. *@
        <LoadingIndicator Message="Reading the weird stuff..."
                          Steps="@(_isGenerating ? _stepDisplay : null)"
                          ActiveStep="@_activeStepIndex" />

        @if (_isGenerating)
        {
            <Storyboard ActiveStep="@_activeStepIndex" Captions="@_storyCaptions" Score="@_storyScore" />
        }
    }
    else if (_error != null)
    {
        @* "Too normal" droops and drains in time with the sad trombone, then perks back up. *@
        <StateCard Class="@(_fizzle ? "error-container state-card--fizzle" : "error-container")"
                   Icon="@_errorIcon" Title="@_errorTitle" Heading1="true" Alert="true">
            <ChildContent>@_error</ChildContent>
            <Actions>
                @* A 429 that says "wait about a minute" needs somewhere to wait a minute and try
                   again. Only offered when a retry could plausibly end differently — a restaurant
                   that does not exist or reviews that are too ordinary will not change. *@
                @if (_canRetry)
                {
                    <button type="button" class="btn btn-primary"
                            disabled="@(_budget is { CanGenerate: false })"
                            @onclick="RetryAsync" data-testid="comic-retry-btn">
                        Try again
                    </button>
                }
                <button type="button" class="btn @(_canRetry ? "btn-secondary" : "btn-primary")" @onclick="GoBack">
                    &#8592; @BackLabel
                </button>
            </Actions>
        </StateCard>
    }
    else if (_needsGeneration)
    {
        <StateCard Class="error-container" Icon="🎨" Title="No comic here yet" Heading1="true">
            <ChildContent>
                This place doesn't have an active comic — it may have expired. Drawing a fresh one
                takes about 10 seconds.
                @* Stated before the tap, not after a 429. The generate button is the one control in
                   the app that spends money, so the cost of pressing it should be visible first. *@
                @if (_budget is { CanGenerate: false })
                {
                    <p class="budget-note" role="status">@BudgetBlockedMessage</p>
                }
                else if (_budget is { Remaining: <= 3 } budget)
                {
                    <p class="budget-note" role="status">@budget.Remaining comic@(budget.Remaining == 1 ? "" : "s") left today.</p>
                }
            </ChildContent>
            <Actions>
                <button type="button" class="btn btn-primary"
                        disabled="@(_budget is { CanGenerate: false })"
                        @onclick="GenerateFromPromptAsync">
                    Generate comic
                </button>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                    &#8592; @BackLabel
                </button>
            </Actions>
        </StateCard>
    }
    else if (_comic != null)
    {
        <div class="comic-toolbar">
            <button type="button" class="btn btn-secondary" @onclick="GoBack">&#8592; @BackLabel</button>
        </div>
        <article class="comic-container glass">
            <div class="comic-header">
                <h1>
                    @_comic.RestaurantName
                    @if (_comic.IsRemastered)
                    {
                        <span class="remaster-chip" title="Redrawn by the premium painter after it climbed the board">Remastered</span>
                    }
                </h1>
                @* The one inline style, and only a custom property: the score has to reach
                   CSS as a number, and 0-100 is not something classes can carry. *@
                <div class="strangeness-ring-wrap" style="--score-target: @_comic.StrangenessScore">
                    <svg class="strangeness-ring" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" class="ring-grad-start"/>
                                <stop offset="100%" class="ring-grad-end"/>
                            </linearGradient>
                        </defs>
                        <circle class="ring-bg" cx="50" cy="50" r="42" />
                        <circle class="ring-fill" cx="50" cy="50" r="42" pathLength="100" />
                    </svg>
                    <div class="ring-label">
                        @* Empty on purpose: CSS prints the animated --score into it. The real
                           number is the visually-hidden line below. *@
                        <span class="ring-score" aria-hidden="true"></span>
                        <span class="ring-text" aria-hidden="true">Weird</span>
                        <span class="visually-hidden">Strangeness @_comic.StrangenessScore out of 100</span>
                    </div>
                    @* A conic sweep behind the ring while the count-up runs, and only then. *@
                    @if (!_scoreLanded)
                    {
                        <div class="sweep-halo ring-halo" aria-hidden="true"></div>
                    }
                </div>
            </div>

            @* ComicImageUrl: an Azurite SAS URL is http, and the browser blocks it as mixed
               content on an https page, so the strip would not render at all locally. *@
            <ComicStrip
                        ImageUrl="@ComicImageUrl.For(_comic.BlobUrl, _comic.PlaceId)"
                        RestaurantName="@_comic.RestaurantName"
                        Captions="@_comic.Captions"
                        Scenes="@_comic.Scenes"
                        PlaceId="@_comic.PlaceId"
                        StrangenessScore="@_comic.StrangenessScore"
                        Develop="@_freshlyDrawn" />

            @* Share is the one action. Report lives only in the disclosure line below. *@
            <ComicActions Comic="_comic" />
            <p class="comic-narrative">@_comic.Narrative</p>
            <p class="comic-disclosure">
                Generated by AI from public reviews. It's a joke, not a review —
                <button type="button" class="link-button" @onclick="() => _isReporting = true">report a problem</button>.
            </p>
        </article>
    }

    @if (_isReporting && _comic is not null)
    {
        <ReportDialog PlaceId="@_comic.PlaceId"
                      RestaurantName="@_comic.RestaurantName"
                      OnClose="() => _isReporting = false" />
    }
</div>

@code {
    [Parameter]
    public string PlaceId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "generate")]
    public bool Generate { get; set; }

    private ComicDto? _comic;
    private GenerationBudgetDto? _budget;
    private bool _isReporting;
    private bool _needsGeneration;
    private bool _isLoading = true;

    /// <summary>
    /// The paid pipeline is in flight. Distinct from <see cref="_isLoading"/>, which also covers
    /// the free cached read: leaving during that used to count as an abandoned generation.
    /// </summary>
    private bool _isGenerating;

    /// <summary>
    /// Whether the last failure is one a retry could change. A rate limit or a dropped
    /// connection is; a missing restaurant or too-ordinary reviews is not.
    /// </summary>
    private bool _canRetry;

    /// <summary>
    /// Set by <see cref="DisposeAsync"/>. Generation is deliberately not cancelled on teardown —
    /// the server runs it to completion so the comic is cached for a return visit — so every
    /// continuation after an await checks this before touching the page.
    /// </summary>
    private bool _disposed;

    private string? _error;
    private string _errorTitle = "Oops!";
    private string _errorIcon = DefaultErrorIcon;
    private const string DefaultErrorIcon = "🤷";

    /// <summary>Bumped each time a reveal starts, so a superseded one does not land twice.</summary>
    private int _revealGeneration;

    /// <summary>Pipeline stage the server last reported, as an index into the step arrays.</summary>
    private int _activeStepIndex;

    /// <summary>The last phase given its sound; the first event of a wait is index 0 too.</summary>
    private int _voicedPhase = -1;

    /// <summary>The failure was "too normal to draw", which deflates rather than alarms.</summary>
    private bool _fizzle;

    private int _motesHandle;

    private bool _scoreLanded;

    /// <summary>What the pipeline has already produced while the artwork is still painting.</summary>
    private IReadOnlyList<string>? _storyCaptions;
    private int? _storyScore;

    /// <summary>
    /// The comic was drawn during this visit, so it develops in rather than just appearing. A
    /// comic opened from a list morphs in from its card instead, and a reveal on top would fight it.
    /// </summary>
    private bool _freshlyDrawn;

    // Aligned one-to-one with the phases the API streams. The order here IS the progress order,
    // so a new pipeline phase must be added here too or the stepper misreports. Phase and copy
    // live in one array on purpose: they used to be two coupled only by array index, where
    // inserting a phase without inserting its icon shifted every step's caption by one.
    private static readonly (ComicGenerationPhase Phase, string Icon, string Label)[] _comicSteps =
    [
        (ComicGenerationPhase.FetchingReviews, "🔍", "Reading the reviews..."),
        (ComicGenerationPhase.AnalyzingStrangeness, "🧠", "Scoring the strangeness..."),
        (ComicGenerationPhase.GeneratingArtwork, "🎨", "Drawing the panels..."),
        (ComicGenerationPhase.ComposingStrip, "✍️", "Lettering the captions..."),
        (ComicGenerationPhase.Publishing, "📮", "Publishing your strip..."),
    ];

    // The stepper only needs the presentation half; projected once, not per render.
    private static readonly (string Icon, string Label)[] _stepDisplay =
        _comicSteps.Select(s => (s.Icon, s.Label)).ToArray();

    // Both recovery cards leave the comic entirely, so they must name the same destination
    // GoBack() actually navigates to.
    private string BackLabel => From == "leaderboard" ? "Back to Hall of Fame" : "Back to Restaurants";

    /// <summary>
    /// Why generation is unavailable. Personal exhaustion and app-wide exhaustion read
    /// differently on purpose — only one of them is about something the user did, and telling
    /// someone they are out of comics when the service is at capacity is simply untrue.
    /// </summary>
    private string BudgetBlockedMessage => _budget switch
    {
        { ServiceHasCapacity: false } => "PoSeeReview has hit its daily drawing limit. Existing comics still open — new ones resume after midnight UTC.",
        _ => "You've used all of today's comic generations. They reset at midnight UTC."
    };

    protected override async Task OnInitializedAsync()
    {
        // Viewing is read-only: try the cached comic first (GET, free). Generation (POST,
        // paid AI pipeline) only runs when the user explicitly asked for it — the search
        // flow navigates with ?generate=true; Hall of Fame / shared links never auto-spend.
        // Started alongside the comic rather than after it: it gates only the generate controls,
        // and a slow budget read must not delay a comic that is already cached.
        var budgetTask = ReadBudgetAsync();

        try
        {
            _comic = await ApiClient.GetCachedComicAsync(PlaceId);
        }
        catch (Exception)
        {
            // Fall through: treat lookup failure like a cache miss.
        }

        _budget = await budgetTask;

        if (_disposed)
        {
            return;
        }

        if (_comic == null)
        {
            if (Generate)
            {
                await LoadComic(forceRegenerate: false);
            }
            else
            {
                _needsGeneration = true;
                _isLoading = false;
                await CueIfBudgetSpentAsync();
            }
        }
        else
        {
            _isLoading = false;
            await OnComicReadyAsync();
            await RevealScoreAsync();
        }
    }

    /// <summary>Arriving at a generate button that is greyed out is a refusal; it should sound like one.</summary>
    private Task CueIfBudgetSpentAsync() =>
        _budget is { CanGenerate: false } ? Fx.PlayErrorAsync() : Task.CompletedTask;

    /// <summary>
    /// Everything that follows a comic arriving, whether it was cached or freshly drawn.
    /// </summary>
    private async Task OnComicReadyAsync()
    {
        if (_comic is null)
        {
            return;
        }

        // Never throws: the history is a convenience and a full or blocked store must not
        // cost the user the comic they just waited for.
        await History.RecordAsync(_comic);
    }

    /// <summary>
    /// Runs the same generation again after a failure that could end differently this time.
    /// </summary>
    private async Task RetryAsync()
    {
        await LoadComic(forceRegenerate: false);
        _budget = await ReadBudgetAsync();
        await CueIfBudgetSpentAsync();
    }

    /// <summary>
    /// The budget gates a button; it is never worth failing the page for. The client already
    /// swallows HTTP failures, but a malformed body or a timeout would still throw out of
    /// <see cref="OnInitializedAsync"/> into the framework error strip.
    /// </summary>
    private async Task<GenerationBudgetDto?> ReadBudgetAsync()
    {
        try
        {
            return await ApiClient.GetGenerationBudgetAsync();
        }
        catch (Exception)
        {
            return null;
        }
    }

    /// <summary>Matches <c>score-roll</c> in ComicView.razor.css.</summary>
    private const int ScoreRollMs = 900;

    /// <summary>
    /// The payoff beat. The count-up itself is CSS (a registered --score animated to the target)
    /// and its ticks and landing chord are one scheduled audio call, so nothing renders or
    /// crosses interop per tick. This only waits it out, then plays the place's own motif —
    /// after the chord, because together they make one muddle instead of two statements — and
    /// retunes the backdrop.
    /// </summary>
    private async Task RevealScoreAsync()
    {
        var score = _comic?.StrangenessScore ?? 0;
        var generation = ++_revealGeneration;
        _scoreLanded = false;

        // Reduced motion shows the score at once, so there is no roll to accompany or wait for.
        var duration = (await Fx.GetCapabilitiesAsync()).ReducedMotion ? 0 : ScoreRollMs;

        StateHasChanged();
        await Fx.PlayScoreRollAsync(score, duration);
        await Task.Delay(duration);

        if (generation != _revealGeneration || _disposed)
        {
            return;
        }

        _scoreLanded = true;   // Drops the conic sweep, which only means something while counting.
        await Fx.PlaySignatureAsync(_comic?.PlaceId ?? PlaceId, score);
        // After the motif, so the loop enters on its own rather than under it.
        await Fx.StartSoundtrackAsync(_comic?.PlaceId ?? PlaceId, score);
        Layout.MainLayout.RaiseScoreChanged(score);
        await Fx.StopMotesAsync(_motesHandle);
        _motesHandle = await Fx.StartMotesAsync(score);
        if (_disposed)
        {
            await Fx.StopMotesAsync(_motesHandle);
            return;
        }

        StateHasChanged();
    }

    private async Task GenerateFromPromptAsync()
    {
        _needsGeneration = false;
        await LoadComic(forceRegenerate: false);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        // The soundtrack, the wait's chord and the motes would otherwise follow the user to the next route.
        await Fx.StopSoundtrackAsync();
        await Fx.StopMotesAsync(_motesHandle);
        if (_isGenerating)
        {
            await Fx.EndWaitAsync(FxWaitOutcome.Abandon);
        }
    }

    private async Task LoadComic(bool forceRegenerate)
    {
        _isLoading = true;
        _isGenerating = true;
        _error = null;
        _errorIcon = DefaultErrorIcon;
        _canRetry = false;
        _fizzle = false;
        _activeStepIndex = 0;
        _voicedPhase = -1;
        _storyCaptions = null;
        _storyScore = null;
        StateHasChanged();

        try
        {
            // Streamed so the stepper reflects the stage the pipeline is genuinely in. The
            // reported phase is mapped through _comicSteps rather than cast, so an unknown
            // phase from a newer API leaves the stepper where it is instead of jumping.
            // Reported inline, not through Progress<T>: that type captures no
            // SynchronizationContext here and would queue each phase to the thread pool — the
            // same race the server moved onto a Channel to avoid. The stream is read on the
            // renderer's context, so the callback already runs where StateHasChanged is legal.
            var progress = new InlineProgress<ComicGenerationEventDto>(evt =>
            {
                var index = Array.FindIndex(_comicSteps, s => s.Phase == evt.Phase);
                if (index < 0 || _disposed)
                {
                    return;
                }

                _activeStepIndex = index;
                if (index != _voicedPhase)
                {
                    _voicedPhase = index;
                    _ = Fx.PlayPhaseAsync(index, _comicSteps.Length);
                }

                if (evt.Captions is { Count: > 0 })
                {
                    _storyCaptions = evt.Captions;
                }

                if (evt.Score is { } early)
                {
                    // The backdrop starts leaning toward this comic's strangeness while it is
                    // still being drawn. The number itself stays hidden until the count-up.
                    _storyScore = early;
                    Layout.MainLayout.RaiseScoreChanged(early);
                }

                StateHasChanged();
            });

            _comic = await ApiClient.GenerateComicStreamAsync(PlaceId, forceRegenerate, progress);

            // The route was torn down while the pipeline ran. The comic is cached server-side
            // for a return visit; starting the reveal timer here would leak it past the page.
            if (_disposed)
            {
                return;
            }

            _freshlyDrawn = !_comic.IsCached;

            await OnComicReadyAsync();

            // Not awaited: the finally below is what takes the loading state down, and the
            // count-up belongs to the comic that then appears.
            _ = RevealScoreAsync();
        }
        catch (HttpRequestException ex)
        {
            // Only the outcomes that time or a second attempt could change.
            _canRetry = ex.StatusCode is not (
                System.Net.HttpStatusCode.BadRequest
                or System.Net.HttpStatusCode.UnprocessableEntity
                or System.Net.HttpStatusCode.NotFound);

            // Three different 422s arrive with one status and one title; the error type tells them apart.
            var tooNormal = ex.Data["errorType"] is "insufficient_strangeness";

            if (tooNormal)
            {
                _errorIcon = "😌";
                _fizzle = true;
            }

            (_errorTitle, _error) = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => (
                    "No reviews to draw from",
                    "We couldn't find any usable reviews for this restaurant, so there's nothing to build a comic out of. Try another place!"),

                // Rejected before the paid image call, and the reservation is refunded.
                System.Net.HttpStatusCode.UnprocessableEntity when tooNormal => (
                    "Too normal to draw",
                    "These reviews are too ordinary to make a comic, so nothing was drawn — it cost nothing and didn't use any of today's comics. Try a place with weirder reviews."),

                // Content blocked, or the image model declined. The server's wording says which.
                System.Net.HttpStatusCode.UnprocessableEntity => (
                    "Couldn't draw this one",
                    string.IsNullOrWhiteSpace(ex.Message)
                        ? "This comic couldn't be drawn. Try another place."
                        : ex.Message),

                // A 429 now means either the per-minute limiter or the daily budget. The
                // server's detail text distinguishes them; falling back to "wait a minute" for
                // a daily cap would be a lie the user discovers 59 seconds later.
                System.Net.HttpStatusCode.TooManyRequests => (
                    "Hold on a moment",
                    string.IsNullOrWhiteSpace(ex.Message)
                        ? "You're generating comics faster than we can draw them. Please wait about a minute and try again."
                        : ex.Message),

                System.Net.HttpStatusCode.NotFound => (
                    "Restaurant not found",
                    "We couldn't find this restaurant. It might have closed or the Google Maps data is unavailable."),

                _ => (
                    "Generation failed",
                    $"Something went wrong while generating the comic. Please try again in a moment. ({ex.Message})")
            };
        }
        catch (Exception ex)
        {
            _canRetry = true;
            _errorTitle = "Unexpected error";
            _error = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isGenerating = false;
            _isLoading = false;

            if (!_disposed)
            {
                await Fx.EndWaitAsync(_error is null ? FxWaitOutcome.Done : FxWaitOutcome.Fail);

                // "Too normal" is an answer, not a malfunction: it deflates rather than alarms.
                if (_error is not null)
                {
                    await (_errorIcon == DefaultErrorIcon ? Fx.PlayErrorAsync() : Fx.PlayFizzleAsync());
                }
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Back through history when there is any, so the list comes back where it was left (scroll,
    /// search and all). A comic opened cold — a shared link in a new tab — has nowhere to go
    /// back to and gets the route instead.
    /// </summary>
    private async Task GoBack()
    {
        // ponytail: history.length also counts pages before the app in this tab, so a link
        // followed from another site goes back there. Track in-app navigations if that matters.
        if (await JS.GetValueAsync<int>("history.length") > 1)
        {
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo(From == "leaderboard" ? "/leaderboard" : "/");
        }
    }

    /// <summary>
    /// <see cref="IProgress{T}"/> that reports on the caller's own context, synchronously.
    /// <see cref="Progress{T}"/> posts to whatever SynchronizationContext it was constructed
    /// on, and here there is none, so it would fall back to the thread pool.
    /// </summary>
    private sealed class InlineProgress<T>(Action<T> report) : IProgress<T>
    {
        public void Report(T value) => report(value);
    }
}
