@page "/diagnostics"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject ApiClient ApiClient
@inject ILogger<Diagnostics> Logger
@using Radzen
@using Radzen.Blazor
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Diagnostics - PoSeeReview</PageTitle>

@if (HostEnvironment.Environment != "Development")
{
    <StateCard Icon="🔒" Title="Development only" Heading1="true">
        <ChildContent>This page is only available in development environments.</ChildContent>
        <Actions><a href="/" class="btn btn-primary">Back to home</a></Actions>
    </StateCard>
}
else
{
<PageShell Title="System Diagnostics"
           Width="PageShell.ShellWidth.Wide"
           Class="diagnostics-container">

    <Header>
        <button type="button" class="btn btn-secondary" @onclick="LoadHealthStatus" disabled="@isLoading">Refresh</button>
    </Header>
    <ChildContent>
    @* One tab strip instead of five stacked sections: on a phone the page was 2.3 screens of
       collapsed and expanded panels. Client render mode keeps every tab in the DOM, so a hidden
       tab still answers a selector. The Graphics tab is the live frame budget (FrameBudget). *@
    <RadzenScope>
        <RadzenTabs RenderMode="TabRenderMode.Client" class="diagnostics-tabs">
            <Tabs>
                <RadzenTabsItem Text="Health">
                @if (isLoading)
                {
                    <LoadingIndicator Message="Checking system health..." />
                }
                else if (healthStatus == null)
                {
                    <StateCard Icon="⚠️" Title="Unable to retrieve health status" Alert="true">
                        <ChildContent>@errorMessage</ChildContent>
                        <Actions><button type="button" class="btn btn-primary" @onclick="LoadHealthStatus">Retry</button></Actions>
                    </StateCard>
                }
                else
                {
                    <div class="health-summary @GetStatusClass(healthStatus.Status)">
                        <div class="status-icon">@GetStatusIcon(healthStatus.Status)</div>
                        <div class="status-details">
                            <h2>Overall Status: @healthStatus.Status</h2>
                            <p><strong>Checked:</strong> @healthStatus.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
                            <p><strong>Duration:</strong> @healthStatus.DurationMilliseconds.ToString("F0") ms</p>
                            <p><strong>Current User:</strong> @(diagnosticsSnapshot?.CurrentUserId ?? "anonymous")</p>
                        </div>
                    </div>

                    <RadzenDataGrid TItem="HealthCheckStatusDto" Data="@healthStatus.Checks" AllowSorting="true" Density="Density.Compact">
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(HealthCheckStatusDto.Name)" Title="Check" MinWidth="12rem">
                                <Template Context="check">@FormatCheckName(check.Name)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Status" Sortable="false" Width="8rem">
                                <Template Context="check">
                                    <RadzenBadge BadgeStyle="@StatusBadgeStyle(check.Status)" Text="@check.Status" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(HealthCheckStatusDto.Description)" Title="Description" />
                            <RadzenDataGridColumn Property="@nameof(HealthCheckStatusDto.DurationMilliseconds)" Title="Duration" Width="7rem" TextAlign="TextAlign.End">
                                <Template Context="check">@check.DurationMilliseconds.ToString("F0") ms</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Error" Sortable="false">
                                <Template Context="check">
                                    @if (!string.IsNullOrEmpty(check.Exception))
                                    {
                                        <details>
                                            <summary class="error-summary">Error Details</summary>
                                            <pre class="error-details">@check.Exception</pre>
                                        </details>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
                </RadzenTabsItem>
                @if (diagnosticsSnapshot != null)
                {
                    <RadzenTabsItem Text="Runtime">
                    <div class="diagnostics-section">
                        <h2 class="visually-hidden">Runtime snapshot</h2>
                        <div class="key-grid">
                            <div class="key-card"><div class="key-name">Environment</div><div class="key-value">@diagnosticsSnapshot.Environment</div></div>
                            <div class="key-card"><div class="key-name">Machine</div><div class="key-value">@diagnosticsSnapshot.MachineName</div></div>
                            <div class="key-card"><div class="key-name">.NET</div><div class="key-value">@diagnosticsSnapshot.DotNetVersion</div></div>
                            <div class="key-card"><div class="key-name">Build</div><div class="key-value">@diagnosticsSnapshot.BuildStamp</div></div>
                            <div class="key-card"><div class="key-name">OS</div><div class="key-value">@diagnosticsSnapshot.OsVersion</div></div>
                        </div>
                    </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Keys">
                    <div class="diagnostics-section">
                        <h2 class="visually-hidden">Critical keys</h2>
                        <div class="key-grid">
                            @foreach (var key in diagnosticsSnapshot.KeyStatus)
                            {
                                <div class="key-card @(key.Exists ? "key-present" : "key-missing")">
                                    <div class="key-name">@key.Key</div>
                                    <div class="key-value">@(key.Value ?? "missing")</div>
                                </div>
                            }
                        </div>
                    </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Config">
                    <div class="diagnostics-section">
                        <h2 class="visually-hidden">Configuration values</h2>
                        <RadzenDataGrid TItem="ConfigurationValueDto" Data="@diagnosticsSnapshot.Config" AllowSorting="true" Density="Density.Compact">
                            <Columns>
                                <RadzenDataGridColumn Property="@nameof(ConfigurationValueDto.Key)" Title="Key" MinWidth="12rem" />
                                <RadzenDataGridColumn Property="@nameof(ConfigurationValueDto.Value)" Title="Value" />
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                    </RadzenTabsItem>
                }
                <RadzenTabsItem Text="Graphics">
                    <FrameBudget />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenScope>
    </ChildContent>
</PageShell>
}

@code {
    private bool isLoading = true;
    private HealthStatusDto? healthStatus;
    private DiagnosticsSnapshotDto? diagnosticsSnapshot;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadHealthStatus();

    private async Task LoadHealthStatus()
    {
        isLoading = true;
        errorMessage = null;
        healthStatus = null;

        try
        {
            Logger.LogInformation("Fetching development diagnostics payloads");
            var healthTask = ApiClient.GetHealthStatusAsync();
            var diagnosticsTask = ApiClient.GetDiagnosticsSnapshotAsync();

            await Task.WhenAll(healthTask, diagnosticsTask);

            healthStatus = healthTask.Result;
            diagnosticsSnapshot = diagnosticsTask.Result;
            Logger.LogInformation("Health status retrieved: {Status}", healthStatus?.Status);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Failed to fetch health status");
            errorMessage = $"HTTP error: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error fetching health status");
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "status-healthy",
        "degraded" => "status-degraded",
        "unhealthy" => "status-unhealthy",
        _ => "status-unknown"
    };

    private string GetStatusIcon(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "✓",
        "degraded" => "!",
        "unhealthy" => "✗",
        _ => "?"
    };

    private static BadgeStyle StatusBadgeStyle(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => BadgeStyle.Success,
        "degraded" => BadgeStyle.Warning,
        "unhealthy" => BadgeStyle.Danger,
        _ => BadgeStyle.Secondary
    };

    private string FormatCheckName(string name) => name
        .Replace("_", " ")
        .Replace("azure", "Azure")
        .Replace("table storage", "Table Storage")
        .Replace("blob storage", "Blob Storage")
        .Replace("google maps api", "Google Maps API")
        .Replace("openai", "OpenAI");

}
