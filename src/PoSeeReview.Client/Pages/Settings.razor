@page "/settings"
@attribute [Authorize]
@using PoSeeReview.Client.Services
@using Microsoft.JSInterop
@inject FxService Fx
@inject IJSRuntime JS

<PageTitle>Settings - PoSeeReview</PageTitle>

@* Every optional extra lives here, and every one starts at its simplest: sound off, standard
   effects. All of it is stored in this browser only. *@
<PageShell Title="Settings" Width="PageShell.ShellWidth.Narrow">
    <section class="settings-group glass" aria-labelledby="settings-appearance">
        <h2 id="settings-appearance">Appearance</h2>
        <div class="settings-row" role="group" aria-label="Color theme">
            @foreach (var (theme, label) in Themes)
            {
                <button type="button"
                        class="chip-toggle @(_theme == theme ? "chip-toggle--active" : "")"
                        aria-pressed="@(_theme == theme ? "true" : "false")"
                        data-testid="@($"settings-theme-{theme}")"
                        @onclick="() => SetThemeAsync(theme)">
                    @label
                </button>
            }
        </div>
        <p class="settings-note">Auto follows your device; pick Light or Dark to pin it.</p>
    </section>

    <section class="settings-group glass" aria-labelledby="settings-sound">
        <h2 id="settings-sound">Sound</h2>

        <div class="settings-row">
            <span class="settings-label">Sound effects</span>
            <button type="button" class="chip-toggle @(_sound ? "chip-toggle--active" : "")"
                    aria-pressed="@(_sound ? "true" : "false")" data-testid="settings-sound" @onclick="ToggleSoundAsync">
                @(_sound ? "On" : "Off")
            </button>
        </div>

        <label class="settings-row">
            <span class="settings-label">Volume</span>
            <input class="settings-volume" type="range" min="0" max="100" disabled="@(!_sound)"
                   @bind="_volume" @bind:event="oninput" @bind:after="ApplyVolumeAsync" />
        </label>

        @* Haptics follow sound and can be switched off on their own, never on on their own.
           Hidden where the Vibration API does not exist (every iOS browser). *@
        @if (_haptics.Supported)
        {
            <div class="settings-row">
                <span class="settings-label">Haptics</span>
                <button type="button" class="chip-toggle @(_haptics.Enabled ? "chip-toggle--active" : "")"
                        aria-pressed="@(_haptics.Enabled ? "true" : "false")" disabled="@(!_sound)" @onclick="ToggleHapticsAsync">
                    @(_haptics.Enabled ? "On" : "Off")
                </button>
            </div>
        }

        <div class="settings-row">
            <span class="settings-label">Comic soundtrack</span>
            <button type="button" class="chip-toggle @(_music ? "chip-toggle--active" : "")"
                    aria-pressed="@(_music ? "true" : "false")" disabled="@(!_sound)" @onclick="ToggleMusicAsync">
                @(_music ? "On" : "Off")
            </button>
        </div>

        <div class="settings-row">
            <span class="settings-label">Map sounds</span>
            <button type="button" class="chip-toggle @(_mapSounds ? "chip-toggle--active" : "")"
                    aria-pressed="@(_mapSounds ? "true" : "false")" disabled="@(!_sound)"
                    data-testid="settings-map-sounds" @onclick="ToggleMapSoundsAsync">
                @(_mapSounds ? "On" : "Off")
            </button>
        </div>
        <p class="settings-note">Map sounds add wind as you drag, a ping when you can search an area, and a low hum from the drawn places.</p>
    </section>

    <section class="settings-group glass" aria-labelledby="settings-effects">
        <h2 id="settings-effects">Visual effects</h2>

        <div class="settings-row" role="group" aria-label="Visual effects">
            @foreach (var (tier, label) in Tiers)
            {
                <button type="button"
                        class="chip-toggle @(_caps.Tier == tier ? "chip-toggle--active" : "")"
                        aria-pressed="@(_caps.Tier == tier ? "true" : "false")"
                        disabled="@(_caps.ReducedMotion || !_caps.WebGl2)"
                        @onclick="() => SetTierAsync(tier)">
                    @label
                </button>
            }
        </div>

        <p class="settings-note">
            @if (_caps.ReducedMotion)
            {
                <text>Your device asked for reduced motion, so effects stay off.</text>
            }
            else if (!_caps.WebGl2)
            {
                <text>This browser can't run the visual effects, so they stay off.</text>
            }
            else if (_caps.AutoDowngraded)
            {
                <text>Effects were turned down because this device was struggling. Reloading restores your choice.</text>
            }
            else
            {
                <text>Full adds the animated backdrop, liquid glass, the rare-comic foil and the celebrations (stamps, confetti, springy scores), and uses more battery.</text>
            }
        </p>

        @* WebGPU only; not offered where the browser has none. *@
        @if (_motes.Supported)
        {
            <div class="settings-row">
                <span class="settings-label">Ink motes</span>
                <button type="button" class="chip-toggle @(_motes.Enabled ? "chip-toggle--active" : "")"
                        aria-pressed="@(_motes.Enabled ? "true" : "false")" disabled="@(_caps.Tier != FxTier.Full)"
                        data-testid="settings-motes" @onclick="ToggleMotesAsync">
                    @(_motes.Enabled ? "On" : "Off")
                </button>
            </div>
            <p class="settings-note">Drifting ink behind a comic, drawn on the GPU. Needs Full effects.</p>
        }
    </section>
</PageShell>

@code {
    private static readonly (FxTier Tier, string Label)[] Tiers =
        [(FxTier.Off, "None"), (FxTier.Lite, "Standard"), (FxTier.Full, "Full")];

    private static readonly (string Value, string Label)[] Themes =
        [("auto", "Auto"), ("light", "Light"), ("dark", "Dark")];

    private string _theme = "auto";

    private FxCapabilities _caps;
    private bool _sound;
    private FxToggleState _haptics;
    private bool _music;
    private bool _mapSounds;
    private FxToggleState _motes;
    private int _volume = 100;

    // After render: every value is read from JS, which prerender does not have.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _caps = await Fx.GetCapabilitiesAsync(refresh: true);
        _sound = await Fx.IsAudioEnabledAsync();
        _haptics = await Fx.GetHapticsAsync();
        _music = await Fx.IsSoundtrackEnabledAsync();
        _mapSounds = await Fx.IsMapSoundsEnabledAsync();
        _motes = await Fx.GetMotesAsync();
        _volume = (int)Math.Round(await Fx.GetVolumeAsync() * 100);
        _theme = await JS.InvokeAsync<string>("poseeTheme.get");
        StateHasChanged();
    }

    private async Task SetThemeAsync(string theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("poseeTheme.set", theme);
    }

    /// <summary>The interop call is the first thing the click does: audio only starts on a gesture.</summary>
    private async Task ToggleSoundAsync()
    {
        _sound = await Fx.SetAudioEnabledAsync(!_sound);
        _haptics = await Fx.GetHapticsAsync();
    }

    private async Task ToggleHapticsAsync()
    {
        await Fx.SetHapticsEnabledAsync(!_haptics.Enabled);
        _haptics = await Fx.GetHapticsAsync();
    }

    private async Task ToggleMusicAsync() => _music = await Fx.SetSoundtrackEnabledAsync(!_music);

    private async Task ToggleMapSoundsAsync() => _mapSounds = await Fx.SetMapSoundsEnabledAsync(!_mapSounds);

    private async Task ToggleMotesAsync()
    {
        await Fx.SetMotesEnabledAsync(!_motes.Enabled);
        _motes = await Fx.GetMotesAsync();
    }

    private Task ApplyVolumeAsync() => Fx.SetVolumeAsync(_volume / 100.0);

    private async Task SetTierAsync(FxTier tier)
    {
        await Fx.UnlockAudioAsync();
        await Fx.SetTierAsync(tier);
        _caps = await Fx.GetCapabilitiesAsync(refresh: true);
    }
}
