<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Do NOT set IsTrimmable on this assembly: the Router/LayoutView instantiate
         components via reflection (typeof(MainLayout) in App.razor), so member-level
         trimming strips their constructors and the published app dies at runtime with
         CtorNotLocated. Blazor's default partial trim mode still trims the framework. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- English-only UI: run invariant so the ~1.5MB ICU payload (icudt_*.dat) is not shipped,
         cutting first-load size and one extra network round-trip. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- IL2110/IL2111 originate in Blazor's own generated App.razor (Router/LayoutView
         reflection) — framework limitations, not app code. Our code stays trim-clean. -->
    <NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
    <!-- The [JSImport] source generator (Services/FxInterop.cs) emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the unit suite can assert the source-generated JSON context round-trips what the API
         actually writes. A naming or enum mismatch there does not throw — it deserializes into a
         default-valued envelope — so it needs a test rather than a reviewer noticing. -->
    <InternalsVisibleTo Include="PoSeeReview.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoSeeReview.Shared\PoSeeReview.Shared.csproj" />
  </ItemGroup>

</Project>
