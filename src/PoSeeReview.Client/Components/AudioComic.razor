@* A made-up visit to the place, overheard, no narrator, built from up to ten reviews. The first tap records it (paid, a few
   seconds) and plays; every later play is the cached recording. The talk is model-written from
   the reviews, so it says so.
   Plays on the user's tap whatever the app's sound-effects switch says: pressing Play is the
   request. A refusal from the voice model is shown with its reason, never hidden. *@
@implements IAsyncDisposable
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@inject ApiClient ApiClient
@inject IJSRuntime JS

<section class="audio-comic" aria-label="Audio comic">
    <div class="audio-comic-row">
        <button type="button" class="btn btn-secondary audio-comic-play" disabled="@_busy" @onclick="PlayAsync">
            <span aria-hidden="true">@(_busy ? "⏺" : "▶")</span>
            @(_busy ? "Recording the voices…" : _manifest is null ? "Listen in" : "Play it again")
        </button>
        <span class="audio-comic-note">AI dramatization · a made-up visit built from the reviews</span>
    </div>
    <audio @ref="_audio" class="audio-comic-player" controls preload="none" hidden="@(_handle == 0)"></audio>
    <p @ref="_caption" class="audio-comic-caption" aria-live="off"></p>
    @if (_error is not null)
    {
        <p class="audio-comic-error" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public string PlaceId { get; set; } = string.Empty;

    private AudioComicDto? _manifest;
    private bool _busy;
    private string? _error;
    private int _handle;
    private ElementReference _audio;
    private ElementReference _caption;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _manifest = await ApiClient.GetAudioComicAsync(PlaceId);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            // Not recorded yet, as far as the button is concerned.
        }
    }

    private async Task PlayAsync()
    {
        _error = null;
        var module = await ModuleAsync();
        if (module is null)
        {
            return;
        }

        // Inside the tap: lets the element play later even if recording outlasts the gesture.
        await module.InvokeVoidAsync("prime", _audio);

        if (_manifest is null)
        {
            _busy = true;
            StateHasChanged();
            try
            {
                _manifest = await ApiClient.RecordAudioComicAsync(PlaceId);
            }
            catch (HttpRequestException ex)
            {
                _error = ex.Message;
                return;
            }
            finally
            {
                _busy = false;
            }
        }

        if (_handle != 0)
        {
            await module.InvokeVoidAsync("stop", _handle);
        }

        _handle = await module.InvokeAsync<int>("play", _audio, _caption, _manifest.Lines, _manifest.AudioUrl);
    }

    private async Task<IJSObjectReference?> ModuleAsync()
    {
        try
        {
            return _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio-comic.js");
        }
        catch (JSException)
        {
            _error = "The player could not start in this browser.";
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            if (_handle != 0)
            {
                await _module.InvokeVoidAsync("stop", _handle);
            }

            await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // The page is already gone.
        }
    }
}
