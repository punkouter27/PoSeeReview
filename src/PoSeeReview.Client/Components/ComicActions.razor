@* The comic page's action bar. Share is the one action — for the Content Creator persona it is
   the entire product. *@
@using PoSeeReview.Client.Services
@using PoSeeReview.Shared.Dtos
@using Microsoft.AspNetCore.Components.Web
@inject ShareService ShareService
@inject FxService Fx

<div class="comic-actions">
    <button type="button" class="btn btn-primary action-share" @onclick="ShareAsync" disabled="@_isBusy">
        <span aria-hidden="true">📤</span> Share
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public ComicDto Comic { get; set; } = default!;

    private bool _isBusy;

    /// <summary>
    /// Also the unlock point: an AudioContext only leaves 'suspended' from a trusted event, and
    /// for a user arriving on a shared comic link this is often the first real gesture on the page.
    /// </summary>
    private async Task ShareAsync(MouseEventArgs e)
    {
        _isBusy = true;

        try
        {
            await Fx.UnlockAudioAsync();
            await Fx.PlayTapAtAsync(e.ClientX);

            var outcome = await ShareService.ShareComicAsync(Comic.PlaceId, Comic.RestaurantName, Comic.StrangenessScore);
            if (outcome is ShareOutcome.Shared or ShareOutcome.Copied)
            {
                await Fx.StampComicAsync();
            }
        }
        finally
        {
            _isBusy = false;
        }
    }
}
