@* One loading display for the whole app, carrying role="status" so a screen reader is told a
   wait is happening. No aria-busy: on a live region that means "hold announcements", and this
   one never cleared it.

   With `Steps` it is a single line — the step the pipeline is on and how far along — because the
   comic page puts the Storyboard directly under it, and the storyboard IS the progress display.
   It used to stack a spinner, the step label, a progress bar and a stepper on top of that:
   five indicators of one wait. *@
<div class="loading-indicator @(Steps is { Length: > 0 } ? "loading-indicator--steps" : "")"
     role="status">
    @if (Steps is { Length: > 0 })
    {
        <p class="stepper-message" @key="_stepIndex">
            <span aria-hidden="true">@Steps[_stepIndex].Icon</span> @Steps[_stepIndex].Label
            <span class="stepper-count">@(_stepIndex + 1)/@Steps.Length</span>
        </p>
        @* One ink dot per phase; the one just reached splats in as its voice joins the wait's chord. *@
        <span class="stepper-pips" aria-hidden="true">
            @for (var i = 0; i < Steps.Length; i++)
            {
                <span class="stepper-pip" data-state="@(i < _stepIndex ? "done" : i == _stepIndex ? "active" : "todo")"></span>
            }
        </span>
    }
    else
    {
        <span class="spinner" aria-hidden="true"></span>
        <p class="loading-message">@Message</p>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading...";
    [Parameter] public (string Icon, string Label)[]? Steps { get; set; }
    [Parameter] public int? ActiveStep { get; set; }

    private int _stepIndex;

    protected override void OnParametersSet()
    {
        _stepIndex = Steps is { Length: > 0 } steps ? Math.Clamp(ActiveStep ?? 0, 0, steps.Length - 1) : 0;
    }
}
