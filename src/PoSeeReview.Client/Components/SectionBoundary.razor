@* An error boundary around one part of a page — the strip, the board, the map — so a component
   that throws takes down only its own section, with a Retry that re-renders just that section.
   The layouts' boundary (ErrorPanel) stays as the last resort for the whole page. *@
<ErrorBoundary @ref="_boundary">
    <ChildContent>@ChildContent</ChildContent>
    <ErrorContent>
        <div class="alert alert-danger section-error" role="alert">
            <span>@Message</span>
            <button type="button" class="btn btn-secondary" @onclick="Retry">Try again</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>What failed, in the user's terms: "The comic couldn't be shown."</summary>
    [Parameter] public string Message { get; set; } = "This part of the page hit a problem.";

    private ErrorBoundary? _boundary;

    private void Retry() => _boundary?.Recover();
}
