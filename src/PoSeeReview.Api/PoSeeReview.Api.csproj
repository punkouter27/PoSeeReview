<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>seereview-api-secrets</UserSecretsId>
    <!-- Git-driven versioning via MinVer -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Direct reference so the fixed Microsoft.OpenApi wins over the vulnerable
         2.0.0 that Microsoft.AspNetCore.OpenApi 10.0.7 drags in (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <!-- Git-tag-driven versioning; the MinVer* properties in Directory.Build.props
         and MinVerTagPrefix above were inert without this reference. -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- Caption and share-card faces (OFL); loaded by SkiaText. Named, not globbed, so a missing
         font fails the compile instead of every caption at runtime. -->
    <EmbeddedResource Include="Imaging\Fonts\Bangers-Regular.ttf" LogicalName="Fonts.Bangers-Regular.ttf" />
    <EmbeddedResource Include="Imaging\Fonts\DMSans-Bold.ttf" LogicalName="Fonts.DMSans-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PoSeeReview.Unit" />
    <InternalsVisibleTo Include="PoSeeReview.Integration" />
    <!-- scripts/prompt-eval.cs: a file-based app is named after its file. -->
    <InternalsVisibleTo Include="prompt-eval" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoSeeReview.Client\PoSeeReview.Client.csproj" />
    <ProjectReference Include="..\PoSeeReview.Shared\PoSeeReview.Shared.csproj" />
  </ItemGroup>

</Project>
