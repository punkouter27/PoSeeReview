{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.StaticFiles": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  CorrelationId={CorrelationId} UserId={UserId} Env={Environment}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/posee-review-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] CorrelationId={CorrelationId} UserId={UserId} Env={Environment} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "PoSeeReview.API"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": "https://kv-poshared2.vault.azure.net/"
  },
  "AzureAd": {
    "ClientId": "cf43692d-ff5a-421e-bd7c-cc59c88414aa",
    "ClientSecret": "",
    "AllowedTenants": [
      "1639b208-d5bf-4d71-9096-06163884a5e4",
      "9188040d-6c67-4c5b-b112-36a304b66dad",
      "3d234255-e20f-4205-88a5-9658a402999b"
    ]
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "HealthChecks": {
    "DetailedErrors": false
  },
  "Comics": {
    "MinimumReviewsRequired": 1,
    "MaximumReviewsForAnalysis": 5,
    "CacheDurationDays": 7,
    "MinimumStrangenessScore": 15,
    "PromptVersion": 4
  },
  "Leaderboard": {
    "MinimumStrangenessScore": 20
  },
  "Moderation": {
    "RequiredRole": "Moderator",
    "AutoHideReportThreshold": 3,
    "QueueWindowDays": 30,
    "QueueLimit": 100,
    "ScreenGeneratedContent": true,
    "ContentSafetyEndpoint": "https://po-aiservices-shared2.cognitiveservices.azure.com/",
    "TriageDeployment": "gpt-5.4-mini"
  },
  "Ai": {
    "ImageProvider": "AzureOpenAI",
    "RemasterProvider": "Gemini",
    "ChatProvider": "AzureOpenAI"
  },
  "Remaster": {
    "Enabled": false,
    "TopN": 10,
    "MaxPerRun": 3,
    "IntervalMinutes": 360
  },
  "Predraw": {
    "Enabled": false,
    "MinScore": 40,
    "MinDemand": 3,
    "MaxPerRun": 5,
    "IntervalHours": 24
  },
  "ImageQa": {
    "SampleRate": 0,
    "Deployment": "gpt-5.4-nano"
  },
  "LocalImage": {
    "BaseUrl": "http://localhost:8080/v1",
    "Model": "sdxl-turbo",
    "LandscapeSize": "768x512",
    "TimeoutSeconds": 300
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/v1",
    "ChatModel": "gemma3:4b",
    "MaxCompletionTokens": 900,
    "TimeoutSeconds": 120
  },
  "AiPricing": {
    "FallbackPer1KTokens": 0.10,
    "FreeProviders": [ "Ollama" ],
    "Models": {
      "gpt-5.4-nano": { "InputPer1KTokens": 0.0002, "CachedInputPer1KTokens": 0.00002, "OutputPer1KTokens": 0.00125 },
      "gpt-5.4-mini": { "InputPer1KTokens": 0.00075, "CachedInputPer1KTokens": 0.000075, "OutputPer1KTokens": 0.0045 },
      "gpt-image-1-mini": { "InputPer1KTokens": 0.002, "OutputPer1KTokens": 0.008 },
      "gemini-2.5-flash-image": { "InputPer1KTokens": 0.0003, "OutputPer1KTokens": 0.03 }
    }
  },
  "GenerationBudget": {
    "DailyPerUserLimit": 10,
    "DailyServiceLimit": 500,
    "Enabled": true
  },
  "RateLimiting": {
    "GlobalPermitLimit": 240,
    "ComicsPostPermitLimit": 3,
    "ReportsPostPermitLimit": 10
  }
}
