<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoSeeReview.Mobile.Pages"
       x:Class="PoSeeReview.Mobile.AppShell"
       Title="PoSeeReview">

    <TabBar>
        <ShellContent Title="Nearby" Route="nearby" ContentTemplate="{DataTemplate pages:NearbyPage}" />
        <ShellContent Title="Hall of Fame" Route="board" ContentTemplate="{DataTemplate pages:BoardPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
