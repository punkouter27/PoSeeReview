<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoSeeReview.Mobile.Pages.BoardPage"
             Title="Hall of Fame">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Global Strangeness Hall of Fame" FontSize="22" FontAttributes="Bold" />
            <Button Text="Refresh (Offline-Cached)" Clicked="OnRefreshClicked" />
            <Label x:Name="StatusLabel" FontSize="12" />
            <VerticalStackLayout x:Name="BoardList" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
