<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoSeeReview.Mobile.Pages.ComicPage"
             Title="Comic">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" FontSize="13" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
            <Label x:Name="StepLabel" FontSize="15" IsVisible="False" />
            <Image x:Name="ComicImage" Aspect="AspectFit" HeightRequest="420" IsVisible="False" Opacity="0" SemanticProperties.Description="The comic strip" />
            <Label x:Name="ScoreLabel" FontSize="18" FontAttributes="Bold" IsVisible="False" />
            <Label x:Name="NarrativeLabel" FontSize="14" IsVisible="False" />
            <Button x:Name="DrawButton" Text="Draw this comic" Clicked="OnDrawClicked" IsVisible="False" />
            <Button x:Name="ShareButton" Text="Share" Clicked="OnShareClicked" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
